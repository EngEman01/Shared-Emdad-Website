@model CategoryEditVM

@{
    var defaultCulture = localizationOptions.Value.DefaultRequestCulture.Culture.Name;
    IEnumerable<Category> categories = ViewBag.Categories;
}

<div class="container-fluid" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; width: 100%;">
    <!-- Image Section -->
    <div class="col-12 col-md-6 d-flex justify-content-center wow bounceInRight mb-4 mb-md-0 mt-4">
        <img src="~/@Model.Category.ImageUrl" alt="Category Image" class="img-fluid " style="min-width:300px; max-width: 500px; max-height: 100%; border-radius:30px;" />
    </div>

    <!-- Form Section -->
    <div class="col-12 col-md-6 mt-5 p-4 wow bounceInLeft" style="background-color:#ffffffb0; border-radius:30px;">
        <div class="modal-body">
            <form asp-area="Admin" asp-controller="Category" asp-action="edit" method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Category.Id" type="hidden" />
                <input asp-for="@Model.CategoryTranslation.Id" type="hidden" />
                <input asp-for="@Model.CategoryTranslation.Language" value="@defaultCulture" type="hidden" />
                <input asp-for="@Model.CategoryTranslation.CategoryId" value="@Model.Category.Id" type="hidden" />
                <div class="mb-3">
                    <label asp-for="@Model.CategoryTranslation.Name" for="categoryName" class="form-label"></label>
                    <input asp-for="@Model.CategoryTranslation.Name" type="text" class="form-control" required>
                    <span asp-validation-for="@Model.CategoryTranslation.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="@Model.CategoryTranslation.Description" for="categoryDescription" class="form-label"></label>
                    <textarea asp-for="@Model.CategoryTranslation.Description" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="@Model.CategoryTranslation.Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="parentCategory" class="form-label">Parent Category</label>
                    <select asp-for="@Model.Category.ParentCategoryId" class="form-select">
                        <option value="">None</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@(category.CategoryTranslations.FirstOrDefault(t => t.Language.ToLower() == defaultCulture.ToLower())?.Name ?? "No Name")</option>
                        }
                    </select>
                    <span asp-validation-for="@Model.Category.ParentCategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="@Model.Category.ImageUrl" for="categoryImage" class="form-label"></label>
                    <input asp-for="@Model.Category.ImageUrl" type="file" name="file" class="form-control" accept="image/*">
                    <span asp-validation-for="@Model.Category.ImageUrl" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>


