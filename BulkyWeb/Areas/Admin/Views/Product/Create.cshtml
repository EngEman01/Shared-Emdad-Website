 @model Product

<div class="container mt-5 p-4">
    <h2 class="text-center">Add New Product</h2>
    <div class="modal-body">
        <form asp-area="Admin" asp-controller="Product" asp-action="Create" id="ProductForm" method="post" enctype="multipart/form-data">
			@*<div class="mb-3">
                 <label asp-for="@Model.DefaultName" for="ProductName" class="form-label">Product Name</label>
                <input asp-for ="@Model.DefaultName" type="text" class="form-control" id="ProductName" name="DefaultName" required>
             </div>*@

			@*<div class="mb-3">
                <label asp-for="@Model.DefaultDescription" for="ProductDescription" class="form-label">Product Description</label>
                <textarea asp-for="@Model.DefaultDescription" class="form-control" id="ProductDescription" name="DefaultDescription" rows="3" required></textarea> 
            </div>*@

            <div class="mb-3">
                <label asp-for="Category" for="ProductCategory" class="form-label">Category</label>
                <select  class="form-select" id="ProductCategory" name="CategoryId" required>
                    <option value="" disabled selected>Select a Category</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id">@category.DefaultName</option>
                    }
                    
                </select>
            </div>
            <div class="mb-3">
                <label  for="ProductSubCategory" class="form-label">SubCategory</label>
                <select class="form-select" id="ProductCategory" name="CategoryId" required>
                    <option value="" disabled selected>Select a Category</option>
                    @foreach (var category in ViewBag.SubCategories)
                    {
                        <option value="@category.Id">@category.DefaultName</option>
                    }

                </select>
            </div>
            <div class="mb-3">
                <label for="ProductImages" class="form-label">Product Images</label>
                <input type="file" class="form-control" id="ProductImages" name="ProductImages" accept="image/*" multiple>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>


