@model IEnumerable<Event>

@{
    ViewData["Title"] = "Events";
    var defaultCulture = localizationOptions.Value.DefaultRequestCulture.Culture.Name;
}
<div class="container mt-5" style="width:1200px;">
    <h2 class="text-center mb-4">Event Management</h2>

    <!-- Add Event Button -->
    <div class="text-center mb-3">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Event" asp-action="Upsert">Add New Event</a>
    </div>

    <!-- Categories Table (Responsive) -->
    <div class="table-responsive index">
        <table class="table table-striped" id="EventTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Start </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="EventTableBody">

                @if(Model != null && Model.Any()){
                    var counter = 1;
                    @foreach (var Event in Model)
                    {
                        <tr>
                            <td>@(counter++)</td>
                            <td>@(Event.EventTranslations?.FirstOrDefault(t => t.Language.ToLower() == defaultCulture.ToLower())?.Name ?? "No Event Name")</td>
                            <td>
                                @(Event.Date.ToString("MMMM dd, yyyy hh:mm tt"))
                            </td>


                            <td>
                                <a asp-area="Admin" asp-controller="Event" asp-action="Show" asp-route-id="@Event.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                <a asp-area="Admin" asp-controller="Event" asp-action="Upsert" asp-route-id="@Event.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Event" asp-action="Delete" asp-route-id="@Event.Id" class="btn btn-danger xbtn-sm"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
                else {
                    <tr>
                        <td colspan="10" class="text-center">No Events yet</td>
                    </tr>
                }
                
                
            </tbody>
        </table>
    </div>
</div>



@section Scripts{
    <script src="~/js/Events.js"></script>
}