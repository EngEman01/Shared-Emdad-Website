@model Product


@{
   

       var isRtlLayout = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;
    var currentUrlLayout = Context.Request.Path.Value + Context.Request.QueryString.Value;
    if (string.IsNullOrEmpty(currentUrlLayout)) { currentUrlLayout = "/"; }
    var currentCultureLayout = System.Threading.Thread.CurrentThread.CurrentCulture.Name.ToLower();
    // Legacy variable kept for compatibility
    var nextCultureLayout = isRtlLayout ? "en-us" : "ar-eg";

    // المتغيرات لمعرفة اسم الـ Controller والـ Action الحالي
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<style>
    .product-details-section {
        background: #f4f7fb;
        min-height: 100vh;
    }

    /* Gallery */
    .product-gallery {
        position: sticky;
        top: 100px;
    }

    .main-image {
        background: #fff;
        padding: 30px;
        border-radius: 25px;
        box-shadow: 0 20px 40px rgba(0,0,0,.08);
        text-align: center;
    }

        .main-image img {
            max-height: 400px;
            object-fit: contain;
        }

    /* Thumbnails */
    .thumb-img {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 15px;
        cursor: pointer;
        transition: all .3s ease;
        border: 2px solid transparent;
    }

        .thumb-img:hover {
            transform: scale(1.05);
            border-color: #022d52;
        }

    /* Info Card */
    .product-info-card {
        background: #ffffff;
        padding: 50px;
        border-radius: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
    }

    .product-title {
        font-size: 32px;
        font-weight: 700;
        color: #1e2a38;
    }

    .product-description {
        font-size: 15px;
        line-height: 1.8;
        color: #555;
    }

    /* Divider */
    .divider {
        width: 60px;
        height: 4px;
        background: #022d52;
        border-radius: 10px;
    }

    /* Button */
    .primary-btn {
        padding: 12px 35px;
        border-radius: 50px;
        border: none;
        background: #022d52;
        color: #fff;
        font-size: 15px;
        transition: all .3s ease;
    }

        .primary-btn:hover {
            background: #c9a14a;
        }

</style>

<section class="product-details-section">
    <div class="container py-5">

        <div class="row g-5">

            <!-- Left: Images -->
            <div class="col-lg-6">

                <div class="product-gallery">

                    <div class="main-image">
                        <img id="mainProductImage"
                             src="@(Url.Content($"~/{Model.Images?.FirstOrDefault()?.ImageURL ?? "images/default_product.png"}"))"
                             class="img-fluid"
                             alt="Product Image">
                    </div>

                    <div class="thumb-images mt-4">
                        <div class="d-flex gap-3 flex-wrap">

                            @if (Model.Images != null && Model.Images.Any())
                            {
                                foreach (var image in Model.Images)
                                {
                                    <img src="@(Url.Content($"~/{image.ImageURL ?? "images/default_product.png"}"))"
                                         class="thumb-img"
                                         onclick="changeMainImage(this)"/>
                                }
                            }

                        </div>
                    </div>

                     <a href="@Url.Action("ContactUs", "Home", new { area = "Customer" })" class="emdad-btn-quote-header">
                    <span>@(isRtlLayout ? "اطلب عرض سعر" : "Request a Quote")</span>
                </a>
                

                </div>


            </div>

            <!-- Right: Info -->
            <div class="col-lg-6">

                <div class="product-info-card">

                    <h1 class="product-title">
                        @(Model.ProductTranslations?.FirstOrDefault()?.Name ?? "Product Name")
                    </h1>

                    <div class="divider my-4"></div>

                    <div class="product-description">
                        @Html.Raw(Model.ProductTranslations?.FirstOrDefault()?.Description ?? "")
                    </div>

                  

                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        function changeMainImage(element) {
            document.getElementById("mainProductImage").src = element.src;
        }
    </script>
}
 *@

                    @model Product

@{
    var isRtlLayout = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;
    var currentUrlLayout = Context.Request.Path.Value + Context.Request.QueryString.Value;
    if (string.IsNullOrEmpty(currentUrlLayout)) { currentUrlLayout = "/"; }
