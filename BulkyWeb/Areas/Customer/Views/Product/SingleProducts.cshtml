<div class="container">
    <div class="row my-4 my-lg-5 align-items-stretch">
        <!-- Added align-items-stretch -->
        <div class="col-12 col-lg-8 wow fadeInRight" data-wow-delay=".001s">
            <img id="big-image" src="~/assets/custom/IMAGE/business1.jpg" alt="Big Image" class="img-fluid">
            <h2 class="font-23 semi-font my-3">
                <a href="#" class="emdad-main-text-color emdad-second-hover-color">Getting to Another Level of Design</a>
            </h2>

            <p class="emdad-forth-text-color emdad-single-blog font-14 my-3 wow fadeIn">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis iaculis egestas nisl vel faucibus.
                Pellentesque ac dapibus orci. In aliquam nisi at est posuere ornare. Aliquam scelerisque magna a
                turpis mollis, eu interdum enim commodo...
            </p>

            <div class="pdf-download">
                <a href="~/assets/custom/files/English.pdf" target="_blank" class="btn btn-primary">
                    <i class="fas fa-file-pdf"></i> Open PDF
                </a>
            </div>
        </div>

        <!-- Small images section with flex adjustment -->
        <div class="col-12 col-lg-4 d-flex flex-column justify-content-between mt-3 mt-lg-0 wow fadeInLeft">
            <div class="row flex-grow-1">
                <!-- Added flex-grow-1 -->
                <div class="col-12 p-0 mb-0">
                    <img src="~/assets/custom/IMAGE/business1.jpg" alt="Image 1" class="thumbnail-img img-fluid" data-large-src="assets/custom/IMAGE/business1.jpg" style="height: 100%; object-fit: cover;">
                </div>
                <div class="col-12 p-0 mb-0">
                    <img src="~/assets/custom/IMAGE/Management1.jpg" alt="Image 2" class="thumbnail-img img-fluid" data-large-src="assets/custom/IMAGE/Management1.jpg" style="height: 100%; object-fit: cover;">
                </div>
                <div class="col-12 p-0 mb-0">
                    <img src="~/assets/custom/IMAGE/management4.jpg" alt="Image 3" class="thumbnail-img img-fluid" data-large-src="assets/custom/IMAGE/management4.jpg" style="height: 100%; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Section -->
<div class="container my-5">
    <h3 class="font-23 semi-font mb-4" id="contact-header" style="cursor: pointer;">
        Contact Us to Purchase This
        Product
    </h3>
    <div class="row">
        <div class="col-12 col-md-8" id="contact-form" style="display: none;">
            <form action="your-server-endpoint" method="post">
                <div class="form-group">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" class="form-control" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Your Email</label>
                    <input type="email" id="email" class="form-control" name="email" required>
                </div>
                <div class="form-group">
                    <label for="message">Your Message</label>
                    <textarea id="message" class="form-control" name="message" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>




