            inset: 0;
            background-image: linear-gradient(rgba(236,231,218,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(236,231,218,0.05) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: radial-gradient(circle at 78% 30%, rgba(0,0,0,0.9), transparent 70%);
        }

    /* radar sweep + rings, anchored to the right/inline-end of the hero */
    .nr-radar {
        position: absolute;
        inset-inline-end: -180px;
        top: 50%;
        transform: translateY(-50%);
        width: 640px;
        height: 640px;
        pointer-events: none;
    }

        .nr-radar .ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid rgb(202 163 92 / 40%);
        }

            .nr-radar .ring.r2 {
                inset: 90px;
            }

            .nr-radar .ring.r3 {
                inset: 180px;
            }

            .nr-radar .ring.r4 {
                inset: 270px;
            }

        .nr-radar .sweep {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: conic-gradient(from 0deg, rgba(202, 163, 92, 0) 0deg, rgb(202 163 92 / 58%) 10deg, rgba(202, 163, 92, 0) 46deg, rgba(202, 163, 92, 0) 360deg);
            animation: nr-sweep 7s linear infinite;
        }

        .nr-radar .blip {
            position: absolute;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--brass);
            box-shadow: 0 0 8px 2px rgba(202,163,92,0.7);
            animation: nr-blip 3.2s ease-in-out infinite;
        }

            .nr-radar .blip.b1 {
                top: 28%;
                inset-inline-start: 62%;
                animation-delay: .2s;
            }

            .nr-radar .blip.b2 {
                top: 58%;
                inset-inline-start: 40%;
                animation-delay: 1.4s;
            }

            .nr-radar .blip.b3 {
                top: 70%;
                inset-inline-start: 66%;
                animation-delay: 2.3s;
            }

    @@keyframes nr-sweep {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes nr-blip {
        0%, 100% {
            opacity: 0;
            transform: scale(.6);
        }

        50% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .nr-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1180px;
        margin-inline: auto;
        padding: 100px 24px 80px;
        width: 100%;
    }

    .nr-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--f-mono);
        font-size: 12px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--brass);
        margin-bottom: 22px;
    }

        .nr-eyebrow .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--brass);
            box-shadow: 0 0 6px 2px rgba(202,163,92,.7);
            animation: nr-pulse 1.8s ease-in-out infinite;
        }

    @@keyframes nr-pulse {
        0%, 100% {
            opacity: .35;
        }

        50% {
            opacity: 1;
        }
    }

    .nr-hero h1 {
        font-family: var(--f-display);
        font-weight: 700;
        text-transform: uppercase;
        font-size: clamp(38px, 6vw, 68px);
        line-height: 1.05;
        letter-spacing: .5px;
        color: var(--paper);
        max-width: 780px;
        margin: 0;
    }

        .nr-hero h1::after {
            content: "";
            display: block;
            width: 96px;
            height: 4px;
            background: var(--brass);
            margin-top: 26px;
        }

    .nr-hero p {
        font-size: 18px;
        line-height: 1.7;
        color: var(--paper-dim);
        max-width: 560px;
        margin: 28px 0 0;
    }

    .nr-coords {
        margin-top: 46px;
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        font-family: var(--f-mono);
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--steel-soft);
        border-top: 1px solid rgba(236,231,218,0.12);
        padding-top: 18px;
        max-width: 620px;
    }

        .nr-coords span b {
            color: var(--paper-dim);
            font-weight: 500;
        }

    /* =========================================================
           DOSSIER GRID
        ========================================================= */
    .nr-body {
        max-width: 1180px;
        margin-inline: auto;
        padding: 70px 24px 110px;
    }

    .nr-body-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 40px;
        border-bottom: 1px solid rgba(202,163,92,0.22);
        padding-bottom: 18px;
    }

        .nr-body-head h2 {
            font-family: var(--f-display);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 22px;
            color: var(--paper);
            margin: 0;
        }

        .nr-body-head span {
            font-family: var(--f-mono);
            font-size: 12px;
            color: var(--steel-soft);
            letter-spacing: 1px;
        }

    .nr-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
    }

    @@media (max-width: 992px) {
        .nr-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .nr-grid {
            grid-template-columns: 1fr;
        }

        .nr-radar {
            display: none;
        }
    }

    /* =========================================================
       TACTICAL DOSSIER CARD
       ========================================================= */

    .nr-card {
        position: relative;
        background: #ffffff;
        border: 1px solid rgba(14, 34, 53, 0.14);
        overflow: hidden;
        isolation: isolate;
        box-shadow: 0 10px 28px rgba(7, 15, 24, 0.07);
        transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease, border-color .35s ease;
        min-height: 100%;
    }


        /* =========================================================
       LEFT / RIGHT TACTICAL MARKER
       ========================================================= */

        .nr-card::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            inset-inline-start: 0;
            width: 4px;
            background: linear-gradient( 180deg, var(--brass) 0%, rgba(224,167,65,.35) 45%, var(--navy) 100% );
            z-index: 8;
            transform: scaleY(.35);
            transform-origin: center;
            transition: transform .45s ease;
        }


        .nr-card:hover::before {
            transform: scaleY(1);
        }


        /* =========================================================
       TOP TECHNICAL LINE
       ========================================================= */

        .nr-card::after {
            content: "";
            position: absolute;
            top: 0;
            inset-inline-end: 0;
            width: 42%;
            height: 1px;
            background: linear-gradient( 90deg, transparent, var(--brass) );
            z-index: 8;
            opacity: .65;
            transition: width .45s ease;
        }


        .nr-card:hover::after {
            width: 72%;
        }


        /* =========================================================
       HOVER
       ========================================================= */

        .nr-card:hover {
            transform: translateY(-8px);
            border-color: rgba(224, 167, 65, .55);
            box-shadow: 0 22px 48px rgba(7, 15, 24, .14);
        }


    /* =========================================================
       DOSSIER FRAME
       ========================================================= */

    .nr-card-frame {
        position: absolute;
        inset: 12px;
        pointer-events: none;
        z-index: 10;
        opacity: 0;
        transition: opacity .35s ease;
    }


    .nr-card:hover .nr-card-frame {
        opacity: 1;
    }


    /* FRAME CORNERS */

    .nr-card-frame i {
        position: absolute;
        width: 19px;
        height: 19px;
        border: 2px solid var(--brass);
        filter: drop-shadow( 0 0 3px rgba(224,167,65,.25) );
    }


        /* TOP LEFT */

        .nr-card-frame i.tl {
            top: 0;
            inset-inline-start: 0;
            border-inline-end: none;
            border-bottom: none;
        }


        /* TOP RIGHT */

        .nr-card-frame i.tr {
            top: 0;
            inset-inline-end: 0;
            border-inline-start: none;
            border-bottom: none;
        }


        /* BOTTOM LEFT */

        .nr-card-frame i.bl {
            bottom: 0;
            inset-inline-start: 0;
            border-inline-end: none;
            border-top: none;
        }


        /* BOTTOM RIGHT */

        .nr-card-frame i.br {
            bottom: 0;
            inset-inline-end: 0;
            border-inline-start: none;
            border-top: none;
        }


    /* =========================================================
       IMAGE AREA
       ========================================================= */

    .nr-card-media {
        position: relative;
        height: 245px;
        overflow: hidden;
        background: #0e2235;
    }


        /* =========================================================
       IMAGE
       ========================================================= */

        .nr-card-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(32%) contrast(108%) brightness(.88);
            transform: scale(1.01);
            transition: transform .9s cubic-bezier(.2,.8,.2,1), filter .7s ease;
        }


    .nr-card:hover .nr-card-media img {
        transform: scale(1.09);
        filter: grayscale(0%) contrast(106%) brightness(.96);
    }


    /* =========================================================
       IMAGE TACTICAL OVERLAY
       ========================================================= */

    .nr-card-media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( 180deg, rgba(7,15,24,.08) 0%, rgba(7,15,24,.12) 42%, rgba(7,15,24,.82) 100% );
        z-index: 1;
        pointer-events: none;
    }


    /* =========================================================
       SCAN LINE
       ========================================================= */

    .nr-card-media::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: -3px;
        height: 2px;
        background: linear-gradient( 90deg, transparent 0%, rgba(224,167,65,.15) 20%, var(--brass) 50%, rgba(224,167,65,.15) 80%, transparent 100% );
        box-shadow: 0 0 12px rgba(224,167,65,.35);
        z-index: 5;
        opacity: 0;
        transform: translateY(0);
    }


    .nr-card:hover .nr-card-media::before {
        opacity: 1;
        animation: nr-card-scan 1.8s ease-in-out infinite;
    }


    @@keyframes nr-card-scan {

        0% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(245px);
        }

        100% {
            transform: translateY(0);
        }
    }


    /* =========================================================
       DOSSIER ID
       ========================================================= */

    .nr-ref {
        position: absolute;
        top: 16px;
        inset-inline-end: 16px;
        z-index: 6;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--f-mono);
        font-size: 10px;
        color: rgba(236,231,218,.78);
        letter-spacing: 1.5px;
        padding: 6px 9px;
        background: rgba(7,15,24,.55);
        border: 1px solid rgba(224,167,65,.28);
        backdrop-filter: blur(6px);
        transition: background .35s ease, color .35s ease, border-color .35s ease;
    }


        /* SMALL STATUS DOT */

        .nr-ref::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--brass);
            box-shadow: 0 0 6px rgba(224,167,65,.65);
        }


    .nr-card:hover .nr-ref {
        color: #ffffff;
        background: rgba(14,34,53,.82);
        border-color: rgba(224,167,65,.65);
    }


    /* =========================================================
       CARD BODY
       ========================================================= */

    .nr-card-body {
        position: relative;
        padding: 24px 24px 26px;
        background: #ffffff;
        min-height: 145px;
    }


        /* =========================================================
       TECHNICAL INDEX
       ========================================================= */

        .nr-card-body::before {
            content: "FIELD REPORT";
            display: block;
            margin-bottom: 10px;
            font-family: var(--f-mono);
            font-size: 9px;
            letter-spacing: 2px;
            color: var(--brass);
            opacity: .9;
        }


        /* =========================================================
       TITLE
       ========================================================= */

        .nr-card-body h3 {
            font-family: var(--f-display);
            font-size: 20px;
            font-weight: 600;
            line-height: 1.3;
            color: var(--navy);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: .4px;
            transition: color .3s ease;
        }


    .nr-card:hover .nr-card-body h3 {
        color: #244d6d;
    }


    /* =========================================================
       GOLD TACTICAL RULE
       ========================================================= */

    .nr-card-rule {
        position: relative;
        width: 42px;
        height: 3px;
        background: var(--brass);
        margin: 17px 0 15px;
        transition: width .45s cubic-bezier(.2,.8,.2,1);
    }


        .nr-card-rule::after {
            content: "";
            position: absolute;
            inset-inline-end: -7px;
            top: 0;
            width: 3px;
            height: 3px;
            background: var(--navy);
        }


    .nr-card:hover .nr-card-rule {
        width: 92px;
    }


    /* =========================================================
       CTA
       ========================================================= */

    .nr-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-family: var(--f-mono);
        font-size: 10px;
        letter-spacing: 1.5px;
        color: #6d7d8b;
        text-transform: uppercase;
        transition: color .3s ease, gap .3s ease;
    }


    .nr-card:hover .nr-card-cta {
        color: var(--navy);
        gap: 13px;
    }


    /* =========================================================
       CTA ICON
       ========================================================= */

    .nr-card-cta svg {
        width: 14px;
        height: 14px;
        transition: transform .3s ease;
    }


    .nr-card:hover .nr-card-cta svg {
        transform: translateX(4px);
    }


    /* RTL */

    [dir="rtl"] .nr-card:hover .nr-card-cta svg {
        transform: translateX(-4px) scaleX(-1);
    }

    [dir="rtl"] .nr-card-cta svg {
        transform: scaleX(-1);
    }


    /* =========================================================
       LINK
       ========================================================= */

    .nr-card a {
        text-decoration: none;
        display: block;
        color: inherit;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @@media (max-width: 640px) {

        .nr-card-media {
            height: 220px;
        }

        .nr-card-body {
            padding: 21px 20px 23px;
        }

            .nr-card-body h3 {
                font-size: 18px;
            }

        .nr-card::before {
            width: 3px;
        }
    }

    .nr-tag {
        position: absolute;
        top: 14px;
        inset-inline-start: 14px;
        z-index: 3;
        font-family: var(--f-mono);
        font-size: 11px;
        letter-spacing: 1.5px;
        color: #ffffff;
        background: rgba(7, 15, 24, .55);
        padding: 4px 10px;
        text-transform: uppercase;
    }

    .nr-ref {
        position: absolute;
        top: 14px;
        inset-inline-end: 14px;
        z-index: 3;
        font-family: var(--f-mono);
        font-size: 11px;
        color: var(--paper-dim);
        letter-spacing: 1px;
    }

    .nr-card-body {
        padding: 20px 20px 24px;
    }

        .nr-card-body h3 {
            font-family: var(--f-display);
            font-size: 19px;
            font-weight: 600;
            line-height: 1.35;
            color: var(--paper);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

    .nr-card-rule {
        width: 40px;
        height: 2px;
        background: var(--brass-dim);
        margin: 14px 0;
        transition: width .35s ease, background .35s ease;
    }

    .nr-card:hover .nr-card-rule {
        width: 70px;
        background: var(--brass);
    }

    .nr-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--f-mono);
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--steel-soft);
        text-transform: uppercase;
    }

        .nr-card-cta svg {
            width: 14px;
            height: 14px;
            transition: transform .3s ease;
        }

    .nr-card:hover .nr-card-cta {
        color: var(--brass);
    }

        .nr-card:hover .nr-card-cta svg {
            transform: translateX(4px);
        }

    [dir="rtl"] .nr-card:hover .nr-card-cta svg {
        transform: translateX(-4px) scaleX(-1);
    }

    [dir="rtl"] .nr-card-cta svg {
        transform: scaleX(-1);
    }

    .nr-card a {
        text-decoration: none;
        display: block;
        color: inherit;
    }

    /* =========================================================
           EMPTY STATE
        ========================================================= */
    .nr-empty {
        text-align: center;
        padding: 90px 24px;
        border: 1px dashed rgba(236,231,218,0.2);
        font-family: var(--f-mono);
        letter-spacing: 1px;
        color: var(--steel-soft);
        text-transform: uppercase;
        font-size: 14px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .nr-radar .sweep, .nr-radar .blip, .nr-eyebrow .dot,
        .nr-card-media img, .nr-card, .nr-card-rule, .nr-card-cta svg {
            animation: none !important;
            transition: none !important;
        }
    }

    /* LARGE SCREENS / 70 INCH / 2K / 4K */
    @@media (min-width: 1400px) {
        .nr-hero-inner,.nr-body{max-width:1380px}.nr-hero{min-height:66vh}.nr-hero-inner{padding:110px 34px 90px}.nr-hero h1{font-size:clamp(54px,4.2vw,82px);max-width:900px}.nr-hero p{font-size:20px;max-width:700px}.nr-body{padding:85px 34px 130px}.nr-body-head h2{font-size:26px}.nr-grid{gap:34px}.nr-card-media{height:285px}.nr-card-body{padding:28px;min-height:165px}.nr-card-body h3{font-size:23px}
    }
    @@media (min-width: 1900px) {
        .nr-hero-inner,.nr-body{max-width:1650px}.nr-hero{min-height:68vh}.nr-hero-inner{padding:130px 48px 105px}.nr-eyebrow{font-size:14px;margin-bottom:28px}.nr-hero h1{font-size:clamp(68px,4vw,100px);max-width:1100px}.nr-hero h1::after{width:125px;height:5px;margin-top:32px}.nr-hero p{font-size:24px;max-width:820px;margin-top:34px}.nr-body{padding:105px 48px 150px}.nr-body-head{margin-bottom:52px;padding-bottom:22px}.nr-body-head h2{font-size:30px}.nr-body-head span{font-size:14px}.nr-grid{gap:40px}.nr-card-media{height:340px}.nr-card-body{padding:32px 34px;min-height:190px}.nr-card-body h3{font-size:27px}.nr-card-rule{width:55px;height:4px;margin:20px 0 18px}.nr-card-cta{font-size:12px}.nr-radar{width:820px;height:820px;inset-inline-end:-240px}.nr-radar .ring.r2{inset:115px}.nr-radar .ring.r3{inset:230px}.nr-radar .ring.r4{inset:345px}
    }
    @@media (min-width: 3000px) {
        .nr-hero-inner,.nr-body{max-width:2050px}.nr-hero{min-height:70vh}.nr-hero-inner{padding:160px 60px 125px}.nr-eyebrow{font-size:17px;letter-spacing:4px;margin-bottom:34px}.nr-hero h1{font-size:clamp(86px,3.8vw,132px);max-width:1400px}.nr-hero h1::after{width:160px;height:6px;margin-top:42px}.nr-hero p{font-size:30px;max-width:1050px;margin-top:44px}.nr-body{padding:135px 60px 190px}.nr-body-head{margin-bottom:65px;padding-bottom:28px}.nr-body-head h2{font-size:38px}.nr-body-head span{font-size:17px}.nr-grid{gap:48px}.nr-card-media{height:420px}.nr-card-body{padding:40px 42px;min-height:225px}.nr-card-body h3{font-size:34px}.nr-card-rule{width:70px;height:5px;margin:25px 0 22px}.nr-card-cta{font-size:14px}.nr-card-cta svg{width:18px;height:18px}.nr-ref,.nr-tag{font-size:13px;padding:8px 12px}.nr-radar{width:1050px;height:1050px;inset-inline-end:-310px}.nr-radar .ring{border-width:3px}.nr-radar .ring.r2{inset:145px}.nr-radar .ring.r3{inset:290px}.nr-radar .ring.r4{inset:435px}
    }
    @@media (min-width: 4200px) {.nr-hero-inner,.nr-body{max-width:2350px}.nr-grid{gap:60px}.nr-card-media{height:500px}}
</style>

<div class="nr-scope">

    <section class="nr-hero">
        <div class="nr-radar" aria-hidden="true">
            <div class="ring r1"></div>
            <div class="ring r2"></div>
            <div class="ring r3"></div>
            <div class="ring r4"></div>
            <div class="sweep"></div>
            <span class="blip b1"></span>
            <span class="blip b2"></span>
            <span class="blip b3"></span>
        </div>

        <div class="nr-hero-inner">
           

            <h1>@localizer["WelcomeNewsRoomEvent"]</h1>
            <p>@localizer["WelcomeNewsRoomContent"]</p>

           
        </div>
    </section>

    <section class="nr-body">

        @{
            int idx = 1;
        }

        @if (Model != null && Model.Any())
        {

            <div class="nr-grid">
                @foreach (var Event in Model.Where(e => e.Id != 13))
                {
                    var refNo = $"NR-{DateTime.Now:yy}-{idx:000}";
                    idx++;

                    <div class="nr-card">

                            <div class="nr-card-frame">
                                <i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>
                            </div>

                            <div class="nr-card-media">
                                <img src="@(Url.Content($"~/{Event?.Images?.FirstOrDefault()?.ImageURL ?? "images/default_Event.png"}"))"
                                     alt="@(Event?.EventTranslations?.FirstOrDefault()?.Name ?? "Event")" />


                                <span class="nr-tag">@localizer["Dossier"]</span>
                                <span class="nr-ref">@refNo</span>
                            
                            </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="nr-empty">@localizer["NoEvents"]</div>
        }

    </section>

</div>
