@model Event

@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    ViewData["Title"] = "Event Premium Experience";
}

<style>
    /* ===== PREMIUM CINEMATIC EVENT ===== */
    body {
        overflow-x: hidden;
    }

    .event-container {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(180deg, #f0f2f5 0%, #e0e6ef 100%);
        padding: 50px 20px;
    }

    /* HERO */
    .event-hero {
        position: relative;
        height: 450px;
        overflow: hidden;
        border-radius: 30px;
        margin-bottom: 80px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.3);
    }

        .event-hero img {
            width: 110%;
            height: 100%;
            object-fit: cover;
            transform: rotate(-1deg) scale(1.05);
            transition: transform 1s ease, filter 1s ease;
        }

        .event-hero:hover img {
            transform: rotate(0deg) scale(1.1);
            filter: brightness(1.1);
        }

        /* Hero Overlay */
        .event-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(160deg, rgba(0,0,0,0.3), rgba(0,0,0,0.6));
            border-radius: 30px;
        }

    /* Hero Title */
    .event-title {
        position: absolute;
        bottom: 40px;
        left: 50px;
        font-size: 46px;
        color: #fff;
        font-weight: 900;
        text-shadow: 4px 4px 25px rgba(0,0,0,0.8);
        transform: rotate(-1deg);
        max-width: 700px;
        line-height: 1.1;
        z-index: 2;
    }

    /* Description Card */
    .event-description {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        padding: 60px 40px;
        max-width: 950px;
        margin: -100px auto 80px auto;
        box-shadow: 0 35px 70px rgba(0,0,0,0.25);
        text-align: center;
        font-size: 20px;
        line-height: 1.7;
        color: #2C3E4F;
    }

    /* Event Collage */
    .event-collage {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 30px;
    }

        .event-collage .event-tile {
            position: relative;
            width: 280px;
            height: 220px;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(0,0,0,0.25);
            transform: rotate(calc(-5deg + var(--rotate))) scale(var(--scale,1));
            transition: transform 0.6s ease, filter 0.6s ease;
        }

            .event-collage .event-tile img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
            }

            .event-collage .event-tile:hover img {
                transform: scale(1.1);
            }

            .event-collage .event-tile::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(160deg, rgba(0,0,0,0.2), rgba(0,0,0,0.45));
                border-radius: 25px;
                transition: background 0.5s ease;
            }

            .event-collage .event-tile:hover::after {
                background: linear-gradient(160deg, rgba(0,0,0,0.1), rgba(0,0,0,0.25));
            }

    /* Random Rotate & Scale */
    .event-tile[data-rotate] {
        --rotate: calc(var(--rotate-angle, 0deg));
    }

    .event-tile[data-scale] {
        --scale: var(--scale-factor, 1);
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .event-hero {
            height: 350px;
        }

        .event-title {
            font-size: 36px;
            left: 25px;
            bottom: 20px;
        }

        .event-description {
            padding: 40px 30px;
            margin: -80px auto 60px auto;
            font-size: 18px;
        }

        .event-collage .event-tile {
            width: 45%;
            height: 180px;
        }
    }

    @@media (max-width: 576px) {
        .event-hero {
            height: 250px;
        }

        .event-title {
            font-size: 28px;
            left: 15px;
            bottom: 15px;
        }

        .event-description {
            padding: 30px 20px;
            font-size: 16px;
        }

        .event-collage .event-tile {
            width: 100%;
            height: 150px;
        }
    }
</style>

<div class="event-container">

    <!-- HERO -->
    <div class="event-hero">
        <img src="~/@(Model.Images?.FirstOrDefault()?.ImageURL ?? "images/default_Event.png")" />
        <div class="event-title">
            @(Model?.EventTranslations?.FirstOrDefault()?.Name ?? "Event Name")
        </div>
    </div>

    <!-- DESCRIPTION -->
    <div class="event-description">
        @Html.Raw(Model?.EventTranslations?.FirstOrDefault()?.Description ?? "")
    </div>

    <!-- COLLAGE IMAGES -->
    @if (Model.Images != null && Model.Images.Count() > 1)
    {
        <div class="event-collage">
            @for (int i = 1; i < Model.Images.Count(); i++)
            {
                var angle = (i % 3 - 1) * 5; // -5deg, 0deg, +5deg
                var scale = 0.95 + (i % 3) * 0.05; // 0.95,1.0,1.05
                                                   <div class="event-tile" style="--rotate-angle:@angle deg; --scale-factor:@scale;">
                                                       <img src="~/@Model.Images[i].ImageURL" />
                                                   </div>
            }
        </div>
    }

</div>
