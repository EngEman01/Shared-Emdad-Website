    /* =========================================================
       OPEN MODAL
       ========================================================= */

    function openSectorModal(sectorKey) {

        const sector =
            emdadSectorData[sectorKey];

        if (!sector) {

            console.warn(
                "EMDAD: Sector not found:",
                sectorKey
            );

            return;
        }


        const modal =
            document.getElementById(
                "sectorModal"
            );


        const language =
            emdadCurrentLanguage === "ar"
                ? "ar"
                : "en";


        /* IMAGE */

        document.getElementById(
            "modalSectorImage"
        ).src =
            sector.image;


        /* ICON */

        const icon =
            document.getElementById(
                "modalSectorIcon"
            );

        icon.className =
            "fa-solid " +
            sector.icon;


        /* CATEGORY */

        document.getElementById(
            "modalSectorCategory"
        ).textContent =
            sector.category[language];


        /* TITLE */

        document.getElementById(
            "modalSectorTitle"
        ).textContent =
            sector.title[language];


        /* SUBTITLE */

        document.getElementById(
            "modalSectorSubtitle"
        ).textContent =
            sector.subtitle[language];


        /* DESCRIPTION */

        document.getElementById(
            "modalSectorDescription"
        ).textContent =
            sector.description[language];


        /* RESPONSIBILITIES */

        const responsibilities =
            document.getElementById(
                "modalResponsibilities"
            );


        responsibilities.innerHTML = "";


        sector.responsibilities[language]
            .forEach(item => {

                const card =
                    document.createElement(
                        "div"
                    );


                card.className =
                    "responsibility-card";


                const iconWrapper =
                    document.createElement(
                        "div"
                    );

                iconWrapper.className =
                    "responsibility-icon";


                const iconElement =
                    document.createElement(
                        "i"
                    );

                iconElement.className =
                    "fa-solid " +
                    item[0];


                iconWrapper.appendChild(
                    iconElement
                );


                const textElement =
                    document.createElement(
                        "span"
                    );

                textElement.textContent =
                    item[1];


                card.appendChild(
                    iconWrapper
                );


                card.appendChild(
                    textElement
                );


                responsibilities.appendChild(
                    card
                );

            });


        /* SHOW MODAL */

        modal.classList.add(
            "active"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        /* LOCK PAGE */

        document.body.style.overflow =
            "hidden";

    }


    /* =========================================================
       CLOSE MODAL
       ========================================================= */

    function closeSectorModal() {

        const modal =
            document.getElementById(
                "sectorModal"
            );


        modal.classList.remove(
            "active"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.style.overflow =
            "";

    }


    /* =========================================================
       ESCAPE KEY
       ========================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape"
            ) {

                closeSectorModal();

            }

        }
    );


    /* =========================================================
       PRINT
       ========================================================= */

    function printSectorDetails() {

        window.print();

    }

</script>