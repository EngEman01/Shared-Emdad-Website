@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name.ToLower();
    ViewData["Title"] = isRtl ? "الهيكل التنظيمي لشركة إمداد | EMDAD" : "Company Structure | EMDAD";
}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Montserrat:wght@500;700;800;900&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --cs-bg-base: #020611;
    --cs-bg-panel: rgba(6, 16, 33, 0.94);
    --cs-bg-card: rgba(10, 24, 48, 0.94);
    --cs-gold: #d4a359;
    --cs-gold-bright: #f0c57d;
    --cs-gold-gradient: linear-gradient(135deg, #f7dfa5 0%, #d4a359 50%, #8a5d16 100%);
    --cs-border: rgba(212, 163, 89, 0.35);
    --cs-border-subtle: rgba(255, 255, 255, 0.08);
    --cs-text: #f8fafc;
    --cs-text-muted: #94a3b8;
    --cs-text-slate: #cbd5e1;
    --cs-red-defense: #ef4444;
    --cs-green-secure: #10b981;
    --cs-blue-it: #0ea5e9;
    --cs-purple-media: #a855f7;
    --font-ar: 'Cairo', sans-serif;
    --font-en: 'Inter', 'Montserrat', sans-serif;
}

.emdad-structure-wrapper {
    background-color: var(--cs-bg-base);
    background-image:
        radial-gradient(circle at 50% 0%, rgba(212, 163, 89, 0.15), transparent 45%),
        linear-gradient(to bottom, rgba(2, 6, 17, 0.92), rgba(2, 6, 17, 0.98));
    color: var(--cs-text);
    font-family: @(isRtl ? "var(--font-ar)" : "var(--font-en)");
    direction: @(isRtl ? "rtl" : "ltr");
    line-height: 1.6;
    overflow-x: hidden;
    padding-bottom: 70px;
    min-height: 100vh;
}

.emdad-structure-wrapper .container {
    width: min(1550px, calc(100% - 30px));
    margin: 0 auto;
}

/* TOP TOOLBAR & CONTROLS */
.structure-top-bar {
    background: rgba(4, 11, 24, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1.5px solid var(--cs-border);
    padding: 14px 0;
    margin-bottom: 10px;
}

.structure-bar-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
}

.structure-brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--cs-gold-bright);
    letter-spacing: @(isRtl ? "0.5px" : "1.5px");
    display: flex;
    align-items: center;
    gap: 10px;
}

.structure-tools {
    display: flex;
    align-items: center;
    gap: 12px;
}

.btn-cs-action {
    background: var(--cs-gold-gradient);
    border: none;
    color: #03070f;
    padding: 9px 20px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.88rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    text-decoration: none;
}

.btn-cs-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 163, 89, 0.5);
    color: #000000;
}

/* HERO & STATS */
.hero-panel {
    padding: 35px 0 25px;
    border-bottom: 1px solid var(--cs-border-subtle);
    background: rgba(2, 6, 17, 0.5);
    text-align: center;
}

.doc-ref {
    font-family: 'JetBrains Mono', monospace;
    color: var(--cs-gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 2px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.hero-title {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
    font-weight: 900;
    margin: 12px 0 15px;
    background: linear-gradient(180deg, #fff3c9 0%, #e6be57 35%, #b88d22 75%, #f6da86 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.7));
}

.hero-subdesc {
    font-size: 1rem;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 auto 20px;
}

.stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 25px;
}

.stat-card {
    background: var(--cs-bg-panel);
    border: 1px solid var(--cs-border-subtle);
    border-left: @(isRtl ? "1px solid var(--cs-border-subtle)" : "4px solid var(--cs-gold)");
    border-right: @(isRtl ? "4px solid var(--cs-gold)" : "1px solid var(--cs-border-subtle)");
    padding: 16px 20px;
    border-radius: 10px;
    text-align: @(isRtl ? "right" : "left");
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
}

.stat-icon {
    font-size: 2rem;
    color: var(--cs-gold-bright);
    flex-shrink: 0;
}

.stat-value {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--cs-gold-bright);
}

.stat-label {
    font-size: 0.82rem;
    color: var(--cs-text-muted);
    font-weight: 600;
}

/* ORGANIZATIONAL TREE */
.chart-section {
    padding: 35px 0 20px;
}

.chart-canvas {
    background: var(--cs-bg-panel);
    backdrop-filter: blur(14px);
    border: 1.5px solid var(--cs-border);
    border-radius: 20px;
    padding: 45px 25px;
    overflow-x: auto;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.75), inset 0 0 30px rgba(212, 163, 89, 0.05);
}

.tree-wrapper {
    min-width: 1240px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.chart-level {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: 28px;
    position: relative;
}

.connector-v {
    width: 2px;
    height: 28px;
    background: var(--cs-gold);
    margin: -18px auto 10px;
    box-shadow: 0 0 10px var(--cs-gold);
}

.node-box {
    background: var(--cs-bg-card);
    border: 1.5px solid var(--cs-border);
    border-radius: 14px;
    padding: 18px 24px;
    text-align: center;
    transition: all 0.35s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
}

.node-box:hover {
    transform: translateY(-5px);
    border-color: var(--cs-gold-bright);
    box-shadow: 0 15px 35px rgba(212, 163, 89, 0.28);
}

.node-chairman {
    width: min(540px, 100%);
    background: linear-gradient(180deg, #182e50 0%, #0b1a33 100%);
    border: 2px solid var(--cs-gold);
}

.node-chairman-icon {
    font-size: 2.3rem;
    color: var(--cs-gold-bright);
    margin-bottom: 8px;
}

.advisory-row {
    display: flex;
    justify-content: center;
    gap: 25px;
    width: 100%;
    margin-bottom: 25px;
    flex-wrap: wrap;
}

.node-advisor {
    flex: 1;
    max-width: 340px;
    background: rgba(6, 17, 34, 0.96);
    border: 1.5px dashed var(--cs-border);
    padding: 14px 20px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    transition: all 0.3s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.node-advisor:hover {
    border-style: solid;
    border-color: var(--cs-gold);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(212, 163, 89, 0.25);
}

.node-coo {
    width: min(460px, 100%);
    background: linear-gradient(180deg, #112a4f 0%, #0a1b33 100%);
    border: 1.5px solid var(--cs-border);
}

/* HORIZONTAL SECTORS GRID */
.executive-horizontal-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 12px;
    width: 100%;
}

.sector-card {
    background: var(--cs-bg-card);
    border: 1.5px solid var(--cs-border);
    border-radius: 12px;
    padding: 18px 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    min-height: 180px;
}

.sector-card:hover {
    border-color: var(--cs-gold);
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.7), 0 0 15px rgba(212, 163, 89, 0.2);
}

.sector-icon {
    font-size: 1.9rem;
    color: var(--cs-gold);
    margin-bottom: 12px;
    transition: transform 0.3s ease;
}

.sector-card:hover .sector-icon {
    transform: scale(1.18) rotate(4deg);
}

.sector-title {
    font-size: 0.86rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 14px;
    line-height: 1.35;
    flex-grow: 1;
}

.btn-explore {
    width: 100%;
    background: rgba(212, 163, 89, 0.12);
    border: 1px solid var(--cs-gold);
    color: var(--cs-gold-bright);
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.25s ease;
}

.btn-explore:hover {
    background: var(--cs-gold);
    color: #03070f;
    box-shadow: 0 3px 12px rgba(212, 163, 89, 0.45);
}

/* DIALOG MODAL */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(2, 6, 17, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.modal-box {
    background: linear-gradient(145deg, #091c36 0%, #040e1b 100%);
    border: 2px solid var(--cs-gold);
    border-radius: 18px;
    width: min(780px, 94%);
    max-height: 88vh;
    overflow-y: auto;
    padding: 28px;
    position: relative;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 35px rgba(212, 163, 89, 0.25);
    transform: scale(0.9) translateY(20px);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    direction: @(isRtl ? "rtl" : "ltr");
    text-align: @(isRtl ? "right" : "left");
}

.modal-overlay.active .modal-box {
    transform: scale(1) translateY(0);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid var(--cs-border);
    padding-bottom: 14px;
    margin-bottom: 20px;
}

.modal-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--cs-gold-bright);
    display: flex;
    align-items: center;
    gap: 10px;
}

.btn-close-modal {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #cbd5e1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.btn-close-modal:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
    transform: rotate(90deg);
}

.modal-body ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.modal-body ul li {
    position: relative;
    padding-right: @(isRtl ? "28px" : "0");
    padding-left: @(isRtl ? "0" : "28px");
    margin-bottom: 14px;
    font-size: 0.95rem;
    color: var(--cs-text-slate);
    line-height: 1.65;
}

.modal-body ul li::before {
    content: "\f058";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    position: absolute;
    right: @(isRtl ? "0" : "auto");
    left: @(isRtl ? "auto" : "0");
    color: var(--cs-gold);
}

/* PRINT SECTION & ENGINE SETUP */
.print-only-container {
    display: none;
}

@@page {
    size: A4 portrait;
    margin: 0;
}

@@media print {
    html, body, .emdad-structure-wrapper {
        background: #ffffff !important;
        color: #0d1b2a !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    header, .emdad-navbar, .emdad-footer, .structure-top-bar, .hero-panel, .chart-section, .btn-explore, .modal-overlay {
        display: none !important;
    }

    .print-only-container {
        display: block !important;
    }

    .print-page {
        page-break-before: always;
        page-break-after: always;
        page-break-inside: avoid;
        box-sizing: border-box;
        padding: 18mm 20mm 15mm 20mm;
        height: 297mm;
        width: 210mm;
        position: relative;
        background: #ffffff;
    }

    .print-page:first-child {
        page-break-before: avoid !important;
    }

    .print-header-frame {
        border-bottom: 3px double #112233;
        padding-bottom: 12px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .print-brand-group {
        text-align: @(isRtl ? "right" : "left");
    }

    .print-company-name {
        font-size: 1.6rem;
        font-weight: 900;
        color: #0b1a30;
        letter-spacing: 1px;
        line-height: 1.1;
    }

    .print-company-sub {
        font-size: 0.8rem;
        font-weight: 700;
        color: #8a5d16;
        text-transform: uppercase;
        margin-top: 3px;
    }

    .print-doc-info {
        text-align: @(isRtl ? "left" : "right");
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #555;
        line-height: 1.4;
    }

    .print-page-title {
        background: #0b1a33;
        color: #ffffff !important;
        padding: 10px 18px;
        font-size: 1.15rem;
        font-weight: 800;
        border-radius: 4px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-right: @(isRtl ? "6px solid #d4a359" : "none");
        border-left: @(isRtl ? "none" : "6px solid #d4a359");
    }

    .print-grid-layout {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-top: 10px;
    }

    .print-box-level {
        border: 1.5px solid #0b1a33;
        border-radius: 6px;
        padding: 12px;
        background: #f8fafc;
    }

    .print-box-header {
        font-size: 1rem;
        font-weight: 900;
        color: #0b1a33;
        border-bottom: 1px solid #d4a359;
        padding-bottom: 5px;
        margin-bottom: 8px;
    }

    .print-sectors-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 10px;
    }

    .print-sector-item {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        padding: 8px 12px;
        border-radius: 4px;
        text-align: @(isRtl ? "right" : "left");
        font-size: 0.85rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .print-table th {
        background: #f1f5f9;
        color: #0b1a33;
        font-size: 0.9rem;
        font-weight: 800;
        padding: 10px;
        border: 1px solid #cbd5e1;
        text-align: @(isRtl ? "right" : "left");
    }

    .print-table td {
        padding: 11px 14px;
        border: 1px solid #e2e8f0;
        font-size: 0.88rem;
        color: #1e293b;
        line-height: 1.6;
    }

    .print-table tr:nth-child(even) td {
        background: #f8fafc;
    }

    .print-num-col {
        width: 40px;
        text-align: center !important;
        font-weight: 800;
        color: #8a5d16;
    }

    .print-footer-frame {
        position: absolute;
        bottom: 15mm;
        left: 20mm;
        right: 20mm;
        border-top: 1px solid #cbd5e1;
        padding-top: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.72rem;
        color: #64748b;
    }

    .print-signature-space {
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        padding: 0 20px;
    }

    .print-seal-box {
        border: 1.5px dashed #94a3b8;
        width: 130px;
        height: 65px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: #94a3b8;
        font-weight: 700;
    }
}
</style>

<div class="emdad-structure-wrapper">

    <!-- TOP TOOLBAR & CONTROLS -->
    <div class="structure-top-bar">
        <div class="container structure-bar-flex">
            <div class="structure-brand-title">
                <i class="fa-solid fa-sitemap"></i>
                <span>@(isRtl ? "الهيكل التنظيمي والحوكمة المؤسسية" : "Corporate Governance & Structure")</span>
            </div>
            <div class="structure-tools">
                <button type="button" class="btn-cs-action" onclick="window.print()">
                    <i class="fa-solid fa-print"></i>
                    <span>@(isRtl ? "طباعة الوثيقة الرسمية" : "Print Official Document")</span>
                </button>
            </div>
        </div>
    </div>

    <!-- HERO & METRICS -->
    <section class="hero-panel">
        <div class="container">
            <span class="doc-ref">
                <i class="fa-solid fa-file-contract"></i>
                <span>EMDAD // ENTERPRISE-GOVERNANCE-2026</span>
            </span>
            <h1 class="hero-title">
                @(isRtl ? "الهيكل التنظيمي العام لشركة إمداد" : "EMDAD General Organizational Structure")
            </h1>
            <p class="hero-subdesc">
                @(isRtl
                    ? "مخطط الحوكمة المؤسسية وتوزيع الصلاحيات التنفيذية والاستشارية والتشغيلية المعتمدة لشركة إمداد"
                    : "Corporate governance chart and distribution of executive, advisory, and operational scopes for EMDAD")
            </p>

            <div class="stats-bar">
                <div class="stat-card">
                    <i class="fa-solid fa-sitemap stat-icon"></i>
                    <div>
                        <div class="stat-value">@(isRtl ? "8 قطاعات" : "8 Sectors")</div>
                        <div class="stat-label">@(isRtl ? "القطاعات التنفيذية التخصصية" : "Specialized Executive Sectors")</div>
                    </div>
                </div>
                <div class="stat-card">
                    <i class="fa-solid fa-bullhorn stat-icon"></i>
                    <div>
                        <div class="stat-value">@(isRtl ? "المجلس التنفيذي" : "PR & Media")</div>
                        <div class="stat-label">@(isRtl ? "منظومة الإعلام والتواصل المؤسسي" : "Media & Corporate Communications")</div>
                    </div>
                </div>
                <div class="stat-card">
                    <i class="fa-solid fa-user-tie stat-icon"></i>
                    <div>
                        <div class="stat-value">@(isRtl ? "العلاقات العامة والإعلام" : "Executive Board")</div>
                        <div class="stat-label">@(isRtl ? "الإدارة العليا والمكاتب الاستشارية" : "Executive Board & Advisory Offices")</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- MAIN ORGANIZATIONAL CHART (WEB VIEW) -->
    <main class="container chart-section">
        <div class="chart-canvas">
            <div class="tree-wrapper">

                <!-- LEVEL 1: CHAIRMAN & CEO -->
                <div class="chart-level">
                    <div class="node-box node-chairman">
                        <i class="fa-solid fa-user-gear node-chairman-icon"></i>
                        <h3>@(isRtl ? "رئيس مجلس الإدارة والعضو المنتدب (CEO)" : "Chairman & Chief Executive Officer (CEO)")</h3>
                        <p style="font-size:0.84rem; color: var(--cs-gold-bright);">
                            @(isRtl ? "السلطة التنفيذية العليا لاتخاذ القرار" : "Supreme Executive Decision-Making Authority")
                        </p>
                        <button type="button" class="btn-explore" style="margin-top:12px;" onclick="openModal('chairman')">
                            <i class="fa-solid fa-eye"></i>
                            <span>@(isRtl ? "استعراض الصلاحيات" : "Explore Scope")</span>
                        </button>
                    </div>
                </div>

                <div class="connector-v"></div>

                <!-- LEVEL 2: ADVISORS & OFFICES -->
                <div class="advisory-row">
                    <div class="node-advisor">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <i class="fa-solid fa-shield-cat" style="color:var(--cs-red-defense); font-size:1.5rem;"></i>
