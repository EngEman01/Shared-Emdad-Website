    function openModal(key) {
      const data = modalData[key];
      if (!data) return;

      const title = data.title[currentLang] || data.title['ar'];
      const items = data.items[currentLang] || data.items['ar'];

      document.getElementById('modalTitle').querySelector('span').innerText = title;

      const bodyHtml = `
        <ul style="padding:10px 0;">
          ${items.map(item => `<li>${item}</li>`).join('')}
        </ul>
      `;
      document.getElementById('modalBody').innerHTML = bodyHtml;

      document.getElementById('modalOverlay').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('modalOverlay').classList.remove('active');
      document.body.style.overflow = '';
    }

    function buildPrintLayout() {
      const target = document.getElementById('printSectionsTarget');
      if (!target) return;
      target.innerHTML = '';

      const isArabic = currentLang === 'ar';
      const keys = Object.keys(modalData);

      keys.forEach((key, index) => {
        const item = modalData[key];
        const title = item.title[currentLang] || item.title['ar'];
        const items = item.items[currentLang] || item.items['ar'];

        const pageDiv = document.createElement('div');
        pageDiv.className = 'print-page';

        pageDiv.innerHTML = `
          <div class="print-header-frame">
            <div class="print-brand-group">
              <div class="print-company-name">${isArabic ? 'شركة إمداد للحلول الصناعية والدفاعية' : 'EMDAD Industrial & Defense Solutions'}</div>
              <div class="print-company-sub">EMDAD INDUSTRIAL & DEFENSE SOLUTIONS</div>
            </div>
            <div class="print-doc-info">
              <b>${isArabic ? 'كود القطاع:' : 'Sector Code:'}</b> SEC-${(index + 1).toString().padStart(2, '0')}<br>
              <b>${isArabic ? 'التاريخ:' : 'Date:'}</b> @DateTime.Now.ToString("yyyy/MM/dd")<br>
              <b>${isArabic ? 'الدرجة:' : 'Status:'}</b> ${isArabic ? 'رسمي / معتمد' : 'Official / Approved'}
            </div>
          </div>

          <div class="print-page-title">
            <span>${isArabic ? 'صلاحيات ومسؤوليات:' : 'Scopes & Responsibilities:'} ${title}</span>
            <span style="font-size:0.8rem; font-weight:normal;">Page ${index + 2} of 12</span>
          </div>

          <table class="print-table">
            <thead>
              <tr>
                <th class="print-num-col">#</th>
                <th>${isArabic ? 'الصلاحية والمهام المعتمدة رسمياً للقطاع' : 'Officially Approved Scope & Responsibilities'}</th>
              </tr>
            </thead>
            <tbody>
              ${items.map((resp, idx) => `
                <tr>
                  <td class="print-num-col">${idx + 1}</td>
                  <td>${resp}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>

          <div class="print-signature-space">
            <div style="text-align:center; font-size:0.8rem; color:#334155;">
              <b>${isArabic ? 'اعتماد رئيس القطاع' : 'Sector Head Ratification'}</b><br><br>__________________
            </div>
            <div style="text-align:center; font-size:0.8rem; color:#334155;">
              <b>${isArabic ? 'اعتماد الرئيس التنفيذي (COO)' : 'COO Ratification'}</b><br><br>__________________
            </div>
            <div class="print-seal-box">${isArabic ? 'خاتم الاعتماد الرسمي' : 'Official Stamp'}</div>
          </div>

          <div class="print-footer-frame">
            <span>${isArabic ? 'شركة إمداد - وثيقة الصلاحيات والمسؤوليات المعتمدة' : 'EMDAD - Approved Governance Charter'}</span>
            <span>${isArabic ? `صفحة ${index + 2} من 12` : `Page ${index + 2} of 12`}</span>
          </div>
        `;

        target.appendChild(pageDiv);
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Build print layout
        buildPrintLayout();
        window.onbeforeprint = buildPrintLayout;

        // Close modal on overlay click
        const modal = document.getElementById('modalOverlay');
        if (modal) {
            modal.addEventListener('click', function (e) {
                if (e.target === this) closeModal();
            });
        }

        // Close on ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    });
</script>
