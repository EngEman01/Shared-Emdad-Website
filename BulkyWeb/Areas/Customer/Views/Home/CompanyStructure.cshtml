            right: auto;
            left: 12px;
        }

        .coordination-card {
            flex-direction: column;
        }

        .operation-flow {
            display: grid;
            grid-template-columns: repeat(2,1fr);
        }

        .emdad-management-note {
            align-items: flex-start;
        }
    }


    /* =========================================================
       PRINT
       ========================================================= */

    @@media print {

        body * {
            visibility: hidden !important;
        }

        .emdad-modal,
        .emdad-modal * {
            visibility: visible !important;
        }

        .emdad-modal {
            position: absolute;
            display: block;
            opacity: 1;
            visibility: visible;
            padding: 0;
        }

        .emdad-modal-backdrop,
        .emdad-modal-close,
        .emdad-modal-footer {
            display: none !important;
        }

        .emdad-modal-container {
            width: 100%;
            max-height: none;
            border: none;
            box-shadow: none;
            transform: none;
        }

        .emdad-modal-body {
            max-height: none;
            overflow: visible;
        }
