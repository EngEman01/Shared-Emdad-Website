            height: 65px;
            font-size: 25px;
        }

        .emdad-stats {
            grid-template-columns: repeat(2,1fr);
        }

        .emdad-sector-grid {
            grid-template-columns: 1fr;
        }

        .emdad-executive-row {
            grid-template-columns: 1fr;
        }

        .emdad-ceo-card {
            flex-direction: column;
            text-align: center;
            padding: 22px;
        }

        .emdad-modal {
            padding: 10px;
        }

        .emdad-modal-container {
            width: 100%;
            max-height: 96vh;
            border-radius: 20px;
        }

        .emdad-modal-body {
            max-height: calc( 96vh - 440px );
            padding: 22px 18px;
        }

        .emdad-responsibilities-grid,
        .emdad-authority-grid {
            grid-template-columns: 1fr;
        }

        .emdad-modal-footer {
            padding: 12px 18px;
            flex-direction: column;
            align-items: stretch;
        }

        .footer-status {
            justify-content: center;
        }

        .modal-actions {
            width: 100%;
        }

        .modal-print-btn,
