@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";

    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isRtl = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var lang = isRtl ? "ar" : "en";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


<style>

    /* =========================================================
       EMDAD ORGANIZATIONAL STRUCTURE
       ========================================================= */

    :root {
        --emdad-navy: #07111f;
        --emdad-navy-2: #0b1b30;
        --emdad-navy-3: #10243d;
        --emdad-gold: #d4af37;
        --emdad-gold-light: #e7c75c;
        --emdad-gold-dark: #a98218;
        --emdad-white: #ffffff;
        --emdad-text: #d8e0ea;
        --emdad-muted: #8998aa;
        --emdad-border: rgba(255,255,255,.09);
        --emdad-gold-border: rgba(212,175,55,.28);
    }


    /* =========================================================
       GLOBAL
       ========================================================= */

    .emdad-structure-page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        background: linear-gradient( 135deg, rgba(3,10,20,.97), rgba(7,17,31,.95) );
        color: var(--emdad-white);
        font-family: 'Inter', 'Cairo', sans-serif;
    }

        .emdad-structure-page[dir="rtl"] {
            font-family: 'Cairo', 'Inter', sans-serif;
        }


    /* =========================================================
       BACKGROUND
       ========================================================= */

    .emdad-page-background {
        position: fixed;
        inset: 0;
        z-index: 0;
        background-image: linear-gradient( rgba(3,10,20,.92), rgba(3,10,20,.97) ), url("https://www.emdadglobal.org/assets/custom/Board%20Of%20Directors/ahmed%20el%20tamawy.jpg");
        background-size: cover;
        background-position: center;
        filter: saturate(.7);
        transform: scale(1.05);
    }


    .emdad-page-glow {
        position: fixed;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient( circle, rgba(212,175,55,.08), transparent 70% );
        top: 10%;
        right: -200px;
        pointer-events: none;
        z-index: 1;
    }


    /* =========================================================
       CONTAINER
       ========================================================= */

    .emdad-structure-container {
        position: relative;
        z-index: 2;
        width: min(1400px, 94%);
        margin: auto;
        padding: 90px 0 100px;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .emdad-structure-hero {
        position: relative;
        min-height: 430px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        border-radius: 30px;
        margin-bottom: 70px;
        background: linear-gradient( rgba(4,12,23,.60), rgba(4,12,23,.92) ), url("https://thumbs.dreamstime.com/z/volkel-netherlands-jun-armament-royal-netherlands-air-force-ah-apache-attack-helicopter-display-volkel-170729942.jpg");
        background-size: cover;
        background-position: center;
        border: 1px solid rgba(212,175,55,.18);
        box-shadow: 0 30px 80px rgba(0,0,0,.45);
        animation: heroReveal 1s ease both;
    }


        .emdad-structure-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient( circle at center, transparent 10%, rgba(3,10,20,.65) 90% );
        }


    .emdad-hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
        padding: 40px;
    }


    .emdad-hero-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: linear-gradient( 135deg, var(--emdad-gold-light), var(--emdad-gold-dark) );
        color: var(--emdad-navy);
        font-size: 32px;
        box-shadow: 0 15px 40px rgba(212,175,55,.22);
        animation: shieldPulse 3s infinite;
    }


    .emdad-hero-eyebrow {
        color: var(--emdad-gold);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 15px;
    }


    .emdad-structure-hero h1 {
        margin: 0;
        font-size: clamp( 34px, 5vw, 62px );
        font-weight: 900;
        line-height: 1.15;
        background: linear-gradient( 90deg, #ffffff, var(--emdad-gold-light), #ffffff );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        background-size: 200% auto;
        animation: goldText 5s linear infinite;
    }


    .emdad-hero-description {
        max-width: 760px;
        margin: 22px auto 0;
        color: #b5c1cf;
        font-size: 15px;
        line-height: 1.9;
    }


    /* =========================================================
       STATS
       ========================================================= */

    .emdad-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 70px;
    }


    .emdad-stat-card {
        padding: 24px;
        text-align: center;
        border-radius: 18px;
        background: linear-gradient( 145deg, rgba(255,255,255,.055), rgba(255,255,255,.018) );
        border: 1px solid var(--emdad-border);
        backdrop-filter: blur(10px);
        transition: transform .3s ease, border-color .3s ease;
    }


        .emdad-stat-card:hover {
            transform: translateY(-6px);
            border-color: var(--emdad-gold-border);
        }


    .emdad-stat-icon {
        color: var(--emdad-gold);
        font-size: 22px;
        margin-bottom: 10px;
    }


    .emdad-stat-number {
        color: white;
        font-size: 25px;
        font-weight: 900;
    }


    .emdad-stat-label {
        color: var(--emdad-muted);
        font-size: 11px;
        margin-top: 4px;
    }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .emdad-section-title {
        text-align: center;
        margin-bottom: 45px;
    }


        .emdad-section-title .eyebrow {
            color: var(--emdad-gold);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }


        .emdad-section-title h2 {
            margin: 8px 0 12px;
            font-size: clamp( 28px, 4vw, 42px );
            font-weight: 800;
        }


        .emdad-section-title p {
            max-width: 750px;
            margin: auto;
            color: var(--emdad-muted);
            line-height: 1.8;
            font-size: 14px;
        }


    /* =========================================================
       ORGANIZATION CHART
       ========================================================= */

    .emdad-org-chart {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 80px;
    }


    /* =========================================================
       CEO
       ========================================================= */

    .emdad-ceo-card {
        position: relative;
        width: min(480px, 100%);
        padding: 15px;
        display: flex;
        align-items: center;
        gap: 18px;
        border-radius: 22px;
        background: linear-gradient( 145deg, rgba(212,175,55,.12), rgba(255,255,255,.04) );
        border: 1px solid rgba(212,175,55,.42);
        box-shadow: 0 20px 50px rgba(0,0,0,.35);
        animation: ceoReveal .8s ease both;
    }


    .emdad-ceo-image {
        width: 90px;
        height: 90px;
        flex-shrink: 0;
        border-radius: 18px;
        object-fit: cover;
        border: 2px solid var(--emdad-gold);
        box-shadow: 0 0 30px rgba(212,175,55,.15);
    }


    .emdad-ceo-label {
        color: var(--emdad-gold);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
    }


    .emdad-ceo-card h3 {
        margin: 0;
        font-size: 21px;
    }


    .emdad-ceo-card p {
        margin: 5px 0 0;
        color: var(--emdad-muted);
        font-size: 12px;
    }


    /* =========================================================
       CONNECTOR
       ========================================================= */

    .emdad-connector {
        width: 2px;
        height: 45px;
        background: linear-gradient( var(--emdad-gold), transparent );
    }


    /* =========================================================
       EXECUTIVE
       ========================================================= */

    .emdad-executive-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(220px, 1fr));
        gap: 18px;
        width: min(800px, 100%);
        margin-bottom: 20px;
    }


    .emdad-executive-card {
        padding: 20px;
        border-radius: 17px;
        text-align: center;
        background: rgba(255,255,255,.035);
        border: 1px solid var(--emdad-border);
        transition: all .3s ease;
    }


        .emdad-executive-card:hover {
            transform: translateY(-5px);
            border-color: var(--emdad-gold-border);
            background: rgba(212,175,55,.05);
        }


    .emdad-executive-icon {
        width: 50px;
        height: 50px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--emdad-gold);
        background: rgba(212,175,55,.09);
    }


    .emdad-executive-card h4 {
        margin: 0;
        font-size: 14px;
    }


    .emdad-executive-card p {
        margin: 7px 0 0;
        color: var(--emdad-muted);
        font-size: 11px;
        line-height: 1.6;
    }


    /* =========================================================
       COO
       ========================================================= */

    .emdad-coo-card {
        width: min(430px, 100%);
        padding: 22px;
        text-align: center;
        border-radius: 19px;
        background: linear-gradient( 135deg, rgba(212,175,55,.12), rgba(255,255,255,.035) );
        border: 1px solid rgba(212,175,55,.30);
    }


    .emdad-coo-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: var(--emdad-gold);
        color: var(--emdad-navy);
        font-size: 21px;
    }


    .emdad-coo-card h3 {
        margin: 0;
        font-size: 18px;
    }


    .emdad-coo-card p {
        color: var(--emdad-muted);
        margin: 7px 0 0;
        font-size: 12px;
    }


    /* =========================================================
       SECTORS GRID
       ========================================================= */

    .emdad-sector-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }


    .emdad-sector-card {
        position: relative;
        min-height: 390px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 20px;
        background: rgba(8,19,34,.88);
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
        transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease;
    }


        .emdad-sector-card:hover {
            transform: translateY(-8px);
            border-color: rgba(212,175,55,.35);
            box-shadow: 0 25px 55px rgba(0,0,0,.4), 0 0 25px rgba(212,175,55,.06);
        }


    /* =========================================================
       SECTOR IMAGE
       ========================================================= */

    .emdad-sector-image {
        position: relative;
        height: 170px;
        overflow: hidden;
    }


        .emdad-sector-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .6s ease;
        }


    .emdad-sector-card:hover
    .emdad-sector-image img {
        transform: scale(1.08);
    }


    .emdad-sector-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( transparent, rgba(5,14,27,.92) );
    }


    /* =========================================================
       SECTOR ICON
       ========================================================= */

    .emdad-sector-icon {
        position: absolute;
        left: 18px;
        bottom: 15px;
        z-index: 2;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--emdad-navy);
        background: linear-gradient( 135deg, var(--emdad-gold-light), var(--emdad-gold-dark) );
        box-shadow: 0 8px 20px rgba(0,0,0,.3);
    }


    /* =========================================================
       SECTOR CONTENT
       ========================================================= */

    .emdad-sector-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 20px;
    }


    .emdad-sector-number {
        color: var(--emdad-gold);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 7px;
    }


    .emdad-sector-content h3 {
        margin: 0;
        color: white;
        font-size: 16px;
        line-height: 1.4;
    }


    .emdad-sector-content p {
        color: var(--emdad-muted);
        font-size: 11px;
        line-height: 1.7;
        margin: 9px 0 18px;
    }


    /* =========================================================
       EXPLORE BUTTON
       ========================================================= */

    .emdad-explore-btn {
        width: 100%;
        margin-top: auto;
        min-height: 43px;
        border-radius: 11px;
        border: 1px solid rgba(212,175,55,.25);
        background: rgba(212,175,55,.06);
        color: var(--emdad-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
        transition: all .3s ease;
    }


        .emdad-explore-btn:hover {
            color: var(--emdad-navy);
            background: linear-gradient( 135deg, var(--emdad-gold-light), var(--emdad-gold-dark) );
            border-color: var(--emdad-gold);
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(212,175,55,.18);
        }


    /* =========================================================
       MODAL
       ========================================================= */

    .emdad-modal {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
        visibility: hidden;
        opacity: 0;
        transition: opacity .35s ease, visibility .35s ease;
    }


        .emdad-modal.active {
            visibility: visible;
            opacity: 1;
        }


    .emdad-modal-backdrop {
        position: absolute;
        inset: 0;
        background: radial-gradient( circle at center, rgba(212,175,55,.08), transparent 40% ), rgba(2,9,20,.90);
        backdrop-filter: blur(14px);
    }


    .emdad-modal-container {
        position: relative;
        width: min( 1100px, 96vw );
        max-height: 92vh;
        overflow: hidden;
        background: linear-gradient( 145deg, rgba(13,25,45,.99), rgba(5,14,27,.99) );
        border: 1px solid rgba(212,175,55,.32);
        border-radius: 26px;
        box-shadow: 0 40px 100px rgba(0,0,0,.7), 0 0 70px rgba(212,175,55,.08);
        transform: translateY(30px) scale(.96);
        transition: transform .4s cubic-bezier(.2,.8,.2,1);
    }


    .emdad-modal.active
    .emdad-modal-container {
        transform: translateY(0) scale(1);
    }


    /* =========================================================
       CLOSE
       ========================================================= */

    .emdad-modal-close {
        position: absolute;
        top: 18px;
        right: 18px;
        z-index: 20;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.15);
        background: rgba(4,12,23,.80);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 18px;
        transition: all .3s ease;
    }


        .emdad-modal-close:hover {
            background: var(--emdad-gold);
            color: var(--emdad-navy);
            transform: rotate(90deg);
            box-shadow: 0 0 25px rgba(212,175,55,.45);
        }


    /* =========================================================
       MODAL HEADER
       ========================================================= */

    .emdad-modal-header {
        display: grid;
        grid-template-columns: 43% 57%;
        min-height: 280px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }


    .emdad-modal-image-wrapper {
        position: relative;
        min-height: 280px;
        overflow: hidden;
    }


    .emdad-modal-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .7s ease;
    }


    .emdad-modal-container:hover
    .emdad-modal-image {
        transform: scale(1.05);
    }


    .emdad-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 90deg, rgba(4,12,23,.05), rgba(4,12,23,.85) );
    }


    .emdad-sector-badge {
        position: absolute;
        left: 22px;
        bottom: 22px;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 15px;
        border-radius: 30px;
        background: rgba(5,14,27,.88);
        border: 1px solid rgba(212,175,55,.5);
        backdrop-filter: blur(10px);
        color: var(--emdad-gold);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }


    /* =========================================================
       MODAL TITLE
       ========================================================= */

    .emdad-modal-title-area {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 45px 55px;
    }


    .emdad-modal-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--emdad-gold);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 15px;
    }


    .emdad-modal-title-area h2 {
        margin: 0;
        color: white;
        font-size: clamp( 27px, 3vw, 42px );
        line-height: 1.15;
        font-weight: 800;
    }


    .emdad-modal-title-area p {
        color: #9eacbd;
        font-size: 14px;
        margin: 13px 0 0;
        line-height: 1.7;
    }


    .emdad-header-line {
        width: 80px;
        height: 3px;
        margin-top: 24px;
        background: linear-gradient( 90deg, var(--emdad-gold), transparent );
        border-radius: 10px;
    }


    /* =========================================================
       MODAL BODY
       ========================================================= */

    .emdad-modal-body {
        max-height: calc( 92vh - 352px );
        overflow-y: auto;
        padding: 35px 45px;
        scrollbar-width: thin;
        scrollbar-color: rgba(212,175,55,.6) rgba(255,255,255,.03);
    }


        .emdad-modal-body::-webkit-scrollbar {
            width: 6px;
        }


        .emdad-modal-body::-webkit-scrollbar-track {
            background: rgba(255,255,255,.02);
        }


        .emdad-modal-body::-webkit-scrollbar-thumb {
            background: rgba(212,175,55,.55);
            border-radius: 10px;
        }


    /* =========================================================
       MODAL SECTION
       ========================================================= */

    .emdad-modal-section {
        margin-bottom: 40px;
    }


    .emdad-section-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }


    .emdad-heading-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--emdad-gold);
        background: linear-gradient( 145deg, rgba(212,175,55,.16), rgba(212,175,55,.04) );
        border: 1px solid rgba(212,175,55,.22);
    }


    .emdad-section-heading span {
        display: block;
        color: var(--emdad-gold);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 3px;
    }


    .emdad-section-heading h3 {
        margin: 0;
        color: white;
        font-size: 19px;
        font-weight: 700;
    }


    /* =========================================================
       OVERVIEW
       ========================================================= */

    .emdad-overview-card {
        display: flex;
        gap: 20px;
        padding: 22px;
        border-radius: 16px;
        background: linear-gradient( 135deg, rgba(255,255,255,.045), rgba(255,255,255,.015) );
        border: 1px solid rgba(255,255,255,.08);
        transition: all .3s ease;
    }


        .emdad-overview-card:hover {
            border-color: rgba(212,175,55,.25);
            transform: translateY(-2px);
        }


    .overview-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--emdad-navy);
        background: linear-gradient( 135deg, var(--emdad-gold-light), var(--emdad-gold-dark) );
        box-shadow: 0 8px 25px rgba(212,175,55,.18);
    }


    .emdad-overview-card p {
        margin: 0;
        color: #b8c3d1;
        font-size: 13px;
        line-height: 1.85;
    }


    /* =========================================================
       RESPONSIBILITIES
       ========================================================= */

    .emdad-responsibilities-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 13px;
    }


    .responsibility-card {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 17px;
        border-radius: 14px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.07);
        transition: all .3s ease;
    }


        .responsibility-card:hover {
            transform: translateY(-4px);
            border-color: rgba(212,175,55,.35);
            background: rgba(212,175,55,.055);
            box-shadow: 0 12px 30px rgba(0,0,0,.2);
        }


    .responsibility-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--emdad-gold);
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.16);
    }


    .responsibility-card span {
        color: #d8e0ea;
        font-size: 12px;
        line-height: 1.6;
        padding-top: 2px;
    }


    /* =========================================================
       AUTHORITY
       ========================================================= */

    .emdad-authority-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 14px;
    }


    .authority-card {
        display: flex;
        gap: 15px;
        padding: 20px;
        border-radius: 15px;
        background: linear-gradient( 135deg, rgba(255,255,255,.04), rgba(255,255,255,.015) );
        border: 1px solid rgba(255,255,255,.07);
        transition: all .3s ease;
    }


        .authority-card:hover {
            transform: translateY(-3px);
            border-color: rgba(212,175,55,.3);
        }


    .authority-icon {
