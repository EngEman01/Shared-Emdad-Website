@model IEnumerable<Product>

<div style="min-height:100vh ; width:100svw; overflow-x:hidden; background: linear-gradient(rgb(2, 45, 82,0.5), #fff),url(/assets/custom/IMAGE/ألصحراء.jpg); background-size:cover; background-attachment: fixed;" class="bg-products">

	﻿<div class="container cont-center">

		<div class="row my-4 my-lg-5">
			<div class="col-12 ">
				<div class="row">
					@if (Model != null && Model.Any())
					{
						@foreach (var product in Model)
						{
							<div class="col-12 col-sm-4 mb-4 product-card">
								<div class="image-container">
									<a asp-area="customer" asp-controller="product" asp-action="Show" asp-route-id="@product.Id" style="text-decoration:none;">
										<img class="img-fluid product-image" src="@(Url.Content($"~/{product?.Images?.FirstOrDefault()?.ImageURL ?? "images/default_product.png"}"))" alt="Card image cap">
										<div class="card-body">
											<h5 class="mt-3 mb-2 font-18 semi-font product-name" style="color:#2C3E4F; text-align:center;">@(product?.ProductTranslations?.FirstOrDefault()?.Name ?? "No Product Translated Name")</h5>
										</div>
									</a>
								</div>
							</div>
						}

					}
					else
					{
						<h2 class="text-white">@localizer["NoProducts"]</h2>
					}
				</div>
			</div>
		</div>
	</div>
</div>

