<script>
    function toggleVideoPlayback() {
        var vid = document.getElementById('emdadCorpVideo');
        var icon = document.getElementById('videoPlayIcon');
        var text = document.getElementById('videoPlayText');
        if (vid) {
            if (vid.paused) {
                vid.play();
                if (icon) icon.className = 'fas fa-pause';
                if (text) text.innerText = '@(isRtl ? "إيقاف مؤقت" : "Pause Video")';
            } else {
                vid.pause();
                if (icon) icon.className = 'fas fa-play';
                if (text) text.innerText = '@(isRtl ? "تشغيل الفيديو" : "Play Video")';
            }
        }
    }

    function toggleVideoMute() {
        var vid = document.getElementById('emdadCorpVideo');
        var icon = document.getElementById('videoMuteIcon');
        if (vid) {
            vid.muted = !vid.muted;
            if (icon) {
                icon.className = vid.muted ? 'fas fa-volume-mute' : 'fas fa-volume-up';
            }
        }
    }
</script>