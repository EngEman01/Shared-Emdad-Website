    .partners-logos-container {
        display: flex;
        align-items: center;
        gap: 32px;
        flex-wrap: wrap;
        flex: 1;
        justify-content: center;
    }

    .partner-wordmark {
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 1px;
        opacity: 0.65;
        transition: opacity 0.25s ease, transform 0.25s ease;
        cursor: default;
        display: inline-flex;
        align-items: center;
    }

        .partner-wordmark:hover {
            opacity: 1;
            transform: scale(1.04);
        }

        .partner-wordmark.rheinmetall {
            color: #d00000;
            font-family: sans-serif;
            font-weight: 900;
        }

        .partner-wordmark.baesystems {
            background: #d00000;
            color: #ffffff;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 3px;
            letter-spacing: 1.5px;
            font-weight: 800;
        }

        .partner-wordmark.cat {
            color: #111111;
            font-family: 'Arial Black', sans-serif;
            font-size: 17px;
            letter-spacing: 0.5px;
        }

            .partner-wordmark.cat span {
                color: #f5b000;
            }

        .partner-wordmark.safran {
            color: #003366;
            font-weight: 800;
        }

        .partner-wordmark.honeywell {
            color: #e61c24;
            font-family: Georgia, serif;
            font-weight: 800;
            font-size: 16px;
        }

        .partner-wordmark.thales {
            color: #002b66;
            font-weight: 900;
            letter-spacing: 2px;
        }

    .btn-view-all-partners {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: var(--emdad-navy) !important;
        font-size: 12px;
        font-weight: 800;
        padding: 9px 18px;
        border: 1.5px solid var(--emdad-navy);
        border-radius: 4px;
        transition: all 0.25s ease;
        white-space: nowrap;
    }

        .btn-view-all-partners:hover {
            background: var(--emdad-navy);
            color: #ffffff !important;
        }

    /* ══════════════════════════════════════════════════════════
       6. KEY PROJECTS & ACHIEVEMENTS SECTION (Image 3 + Video)
       ══════════════════════════════════════════════════════════ */
    .emdad-achievements-section {
        background: #041424;
        padding: clamp(65px, 8vw, 95px) 0;
        position: relative;
        overflow: hidden;
        color: #ffffff;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

        .emdad-achievements-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 85% 15%, rgba(11, 58, 103, 0.45) 0%, transparent 60%), radial-gradient(circle at 15% 85%, rgba(212, 175, 55, 0.08) 0%, transparent 50%);
            pointer-events: none;
        }

    .achievements-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1.5px solid rgba(212, 175, 55, 0.4);
        border-radius: 8px;
        background: linear-gradient(90deg, rgba(6, 35, 63, 0.95) 0%, rgba(3, 20, 36, 0.98) 100%);
        padding: 18px 26px;
        margin-bottom: 34px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
    }

    .achievements-brand-badge {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .achievements-wings-icon {
        color: var(--emdad-gold);
        font-size: 32px;
        filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.4));
    }

    .achievements-brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .achievements-brand-main {
        font-size: 17px;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: 2px;
    }

    .achievements-brand-sub {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--emdad-gold-light);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .achievements-title-combo {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .achievements-header-title {
        font-family: var(--font-heading);
        font-size: clamp(18px, 2vw, 24px);
        font-weight: 800;
        color: var(--emdad-gold-light);
        letter-spacing: @(isRtl ? "0" : "1.5px");
        text-transform: uppercase;
        margin: 0;
    }

    .achievements-main-grid {
        display: grid;
        grid-template-columns: 430px 1fr;
        gap: 28px;
        align-items: stretch;
    }

    /* Video Showcase Card */
    .achievements-video-card {
        background: linear-gradient(145deg, #06233f 0%, #031424 100%);
        border: 1.5px solid rgba(212, 175, 55, 0.35);
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .video-container-inner {
        position: relative;
        width: 100%;
        flex: 1;
        min-height: 280px;
        background: #000000;
        overflow: hidden;
    }

        .video-container-inner video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .video-card-body {
        padding: 22px 20px;
        background: rgba(3, 20, 36, 0.95);
        border-top: 1px solid rgba(212, 175, 55, 0.2);
    }

    .video-card-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 10.5px;
        font-weight: 800;
        color: var(--emdad-gold-light);
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

        .video-card-badge i {
            color: #e61c24;
            font-size: 8px;
            animation: pulse 1.5s infinite;
        }

    .video-card-title {
        font-size: 15px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
    }

    .video-card-desc {
        font-size: 12px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.75);
        margin-bottom: 14px;
    }

    .video-card-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-video-action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%);
        color: #061d33 !important;
        font-size: 12px;
        font-weight: 800;
        padding: 8px 16px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .btn-video-action:hover {
            background: linear-gradient(135deg, #ffffff 0%, #f5d47a 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4);
        }

    .btn-video-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 700;
        padding: 8px 14px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        text-decoration: none;
        transition: all 0.25s ease;
    }

        .btn-video-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #ffffff;
        }

    /* 6 Achievement List Rows (Display only) */
    .achievements-rows-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .achievement-row-item {
        background: linear-gradient(90deg, rgba(6, 35, 63, 0.85) 0%, rgba(3, 20, 36, 0.92) 100%);
        border: 1px solid rgba(212, 175, 55, 0.28);
        border-radius: 6px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: all 0.3s ease;
        color: #ffffff;
        cursor: default;
    }

        .achievement-row-item:hover {
            background: linear-gradient(90deg, rgba(11, 58, 103, 0.95) 0%, rgba(6, 35, 63, 0.98) 100%);
            border-color: var(--emdad-gold);
            transform: translateY(-2px);
            box-shadow: 0 4px 18px rgba(212, 175, 55, 0.2);
        }

    .achievement-icon-octa {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        background: rgba(212, 175, 55, 0.12);
        border: 1.5px solid var(--emdad-gold);
        color: var(--emdad-gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .achievement-row-item:hover .achievement-icon-octa {
        background: var(--emdad-gold);
        color: #041628;
        box-shadow: 0 0 14px rgba(212, 175, 55, 0.5);
    }

    .achievement-text-single {
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.5;
        flex: 1;
    }

    :root {
        --emdad-gold: #d4a359;
        --emdad-gold-bright: #f0c57d;
        --emdad-navy: #061021;
        --emdad-card-bg: rgba(10, 24, 48, 0.85);
        --emdad-border: rgba(212, 163, 89, 0.3);
    }

    .emdad-achievements-section {
        background: var(--emdad-navy);
        padding: 80px 0;
        color: #fff;
    }

    .emdad-wrap {
        width: min(1380px, 92%);
        margin: 0 auto;
    }

    /* Header Styling */
    .achievements-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--emdad-border);
        padding-bottom: 25px;
        margin-bottom: 50px;
    }

    .achievements-brand-badge {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .achievements-wings-icon {
        font-size: 2.2rem;
        color: var(--emdad-gold-bright);
    }

    .achievements-brand-main {
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--emdad-gold-bright);
        display: block;
        letter-spacing: 2px;
    }

    .achievements-brand-sub {
        font-size: 0.75rem;
        color: #94a3b8;
        letter-spacing: 1px;
    }

    .achievements-header-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #fff;
    }

    /* Spacious Grid Structure (3 Columns with Distinct Spacing) */
    .achievements-spacious-grid {
        display: grid;
        grid-template-columns: 1fr 310px 1fr; /* عرض الفيديو أصلح وأصغر (310px) */
        gap: 45px; /* مسافات واسعة ومريحة بين الأعمدة */
        align-items: center;
    }

    /* Vertical Spacing between Cards in Columns */
    .achievements-column {
        display: flex;
        flex-direction: column;
        gap: 28px; /* مسافة أفقية مريحة بين كروت الإنجازات */
    }

    /* Achievement Cards */
    .achievement-row-item {
        background: var(--emdad-card-bg);
        border: 1px solid var(--emdad-border);
        border-radius: 14px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

        .achievement-row-item:hover {
            transform: translateY(-4px);
            border-color: var(--emdad-gold);
            box-shadow: 0 10px 25px rgba(212, 163, 89, 0.15);
        }

    .achievement-icon-octa {
        width: 48px;
        height: 48px;
        background: rgba(212, 163, 89, 0.12);
        border: 1.5px solid var(--emdad-gold);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--emdad-gold-bright);
        flex-shrink: 0;
    }

    .achievement-text-single {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.5;
        color: #e2e8f0;
    }

    /* Centered Compact Video Column */
    .achievements-video-center {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Compact Square Video Card */
    .achievements-video-card.compact-square-mode {
        position: relative;
        width: 310px; /* حجم مربع صغير ومتناسق */
        height: 310px;
        border-radius: 20px;
        overflow: hidden;
        border: 2px solid var(--emdad-gold);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7);
    }

    .video-container-inner {
        width: 100%;
        height: 100%;
        position: relative;
    }

        .video-container-inner video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Overlay Video Info */
    .video-overlay-content {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(2, 6, 17, 0.95) 0%, rgba(2, 6, 17, 0.2) 60%, transparent 100% );
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 18px;
    }

    .video-card-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        color: var(--emdad-gold-bright);
        background: rgba(0, 0, 0, 0.6);
        padding: 3px 10px;
        border-radius: 20px;
        width: fit-content;
        margin-bottom: 6px;
        border: 1px solid rgba(212, 163, 89, 0.3);
    }

    .live-dot {
        font-size: 0.45rem;
        color: #22c55e;
        animation: pulse 1.5s infinite;
    }

    .video-card-title {
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 10px;
    }

    .video-card-actions {
        display: flex;
        gap: 8px;
    }

    .btn-video-action,
    .btn-video-outline {
        background: var(--emdad-gold);
        border: none;
        color: #020617;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }

    .btn-video-outline {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        backdrop-filter: blur(5px);
    }

    .btn-video-action:hover {
        background: var(--emdad-gold-bright);
    }

    .btn-video-outline:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    @@keyframes pulse {
        0% {
            opacity: 0.3;
        }

        50% {
            opacity: 1;
        }

        100% {
            opacity: 0.3;
        }
    }

    /* Responsive Handling */
    @@media (max-width: 1024px) {
        .achievements-spacious-grid {
            grid-template-columns: 1fr;
            gap: 35px;
        }
    }

    /* ══════════════════════════════════════════════════════════
       7. LATEST NEWS SECTION
       ══════════════════════════════════════════════════════════ */
    .emdad-news-section {
        background: #f8fafc;
        padding: clamp(65px, 8vw, 95px) 0;
    }

    .news-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .news-item-card {
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--emdad-border);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

        .news-item-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(6, 39, 71, 0.12);
        }

    .news-card-thumb {
        height: 135px;
        overflow: hidden;
        position: relative;
    }

        .news-card-thumb img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .news-item-card:hover .news-card-thumb img {
        transform: scale(1.07);
    }

    .news-card-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .news-card-date {
        font-size: 10.5px;
        font-weight: 700;
        color: #9a7228;
        letter-spacing: @(isRtl ? "0" : "1.5px");
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .news-card-title {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--emdad-ink);
        line-height: 1.4;
        margin-bottom: 8px;
    }

    .news-card-snippet {
        font-size: 11.5px;
        line-height: 1.6;
        color: var(--emdad-muted);
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .news-card-readmore {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--emdad-navy);
        transition: all 0.2s ease;
    }

    .news-item-card:hover .news-card-readmore {
        color: var(--emdad-gold);
        gap: 9px;
    }

    /* ══════════════════════════════════════════════════════════
       8. CTA BANNER (Exact Design with Sunset Clouds & Glowing Globe)
       ══════════════════════════════════════════════════════════ */
    .emdad-cta-banner {
        position: relative;
        background-image: url('/assets/custom/images/Copilot_20260913_232200.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: #ffffff;
        padding: clamp(55px, 7vw, 75px) 0;
        overflow: hidden;
    }

    .emdad-cta-banner-overlay {
        position: absolute;
        inset: 0;
        background: @(isRtl
                ? "linear-gradient(270deg, rgba(4, 26, 50, 0.6) 0%, rgba(4, 26, 50, 0.2) 60%, transparent 100%)"
                : "linear-gradient(90deg, rgba(4, 26, 50, 0.6) 0%, rgba(4, 26, 50, 0.2) 60%, transparent 100%)");
        z-index: 1;
    }

    .cta-banner-inner {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        flex-wrap: wrap;
    }

    .cta-banner-text h2 {
        font-family: var(--font-heading);
        font-size: clamp(24px, 3vw, 36px);
        font-weight: 700;
        color: #ffffff;
        line-height: 1.25;
        margin-bottom: 8px;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .cta-banner-text p {
        font-size: 15px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.92);
        max-width: 620px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    }

    .btn-cta-contact {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%);
        color: #061d33 !important;
        font-size: 14px;
        font-weight: 800;
        padding: 14px 28px;
        border-radius: 6px;
        white-space: nowrap;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        transition: all 0.25s ease;
    }

        .btn-cta-contact:hover {
            background: linear-gradient(135deg, #ffffff 0%, #f5d47a 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(212, 175, 55, 0.5);
        }

    /* ══════════════════════════════════════════════════════════
       9. EGYPTIAN NATIONAL PRIDE STRIP
       ══════════════════════════════════════════════════════════ */
    .egyptian-pride-strip {
        background: #03172c;
        color: #ffffff;
        padding: 24px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .egyptian-pride-inner {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 20px;
    }

    .egyptian-pride-graphic {
        display: flex;
        align-items: center;
        gap: 14px;
        opacity: 0.85;
    }

    .egyptian-pride-text {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        color: var(--emdad-gold-light);
        text-transform: uppercase;
        text-align: right;
        line-height: 1.4;
    }

    /* ══════════════════════════════════════════════════════════
       RESPONSIVE BREAKPOINTS
       ══════════════════════════════════════════════════════════ */
    @@media (max-width: 1024px) {
        .identity-row-grid {
            grid-template-columns: 1fr;
        }

        .achievements-main-grid {
            grid-template-columns: 1fr;
        }

        .achievements-header-bar {
            flex-direction: column;
            gap: 14px;
            text-align: center;
        }

        .achievements-title-combo {
            justify-content: center;
        }

        .emdad-sectors-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .why-section-grid {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .why-features-row {
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .projects-section-layout {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .projects-cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .news-cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-badges-row {
            flex-wrap: wrap;
            gap: 16px;
        }
    }

    @@media (max-width: 768px) {
        .stats-bar-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 18px 0;
