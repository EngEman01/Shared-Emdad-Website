@model HomeVM

@{
    var isRtl = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture.Name.ToLower();
    ViewData["Title"] = isRtl ? "الرئيسية" : "Home";
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
    if (string.IsNullOrEmpty(returnUrl)) { returnUrl = "/"; }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap');

    /* ══════════════════════════════════════════════════════════
       GLOBAL VARIABLES & RESET
       ══════════════════════════════════════════════════════════ */
    :root {
        --emdad-navy: #062747;
        --emdad-navy-deep: #031b31;
        --emdad-navy-mid: #0b3a67;
        --emdad-gold: #d4af37;
        --emdad-gold-light: #f3d078;
        --emdad-gold-dark: #b89228;
        --emdad-ink: #0e2238;
        --emdad-body: #415366;
        --emdad-muted: #6b7c8f;
        --emdad-light: #f5f7fa;
        --emdad-border: #e2e7ee;
        --emdad-white: #ffffff;
        --font-heading: @(isRtl ? "'Cairo', serif" : "'Playfair Display', Georgia, serif");
        --font-body: @(isRtl ? "'Cairo', sans-serif" : "'Inter', -apple-system, BlinkMacSystemFont, sans-serif");
        --ease-smooth: cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    /* ══════════════════════════════════════════════════════════
       NAVBAR OVERRIDE (Match Reference Image: Dark Navy Header)
       ══════════════════════════════════════════════════════════ */
    #emdadMainNav.emdad-navbar,
    .emdad-navbar {
        background: #061d33 !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35) !important;
        padding: 0.65rem 0 !important;
        transition: all 0.3s ease;
    }

    #emdadMainNav .navbar-brand {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        text-decoration: none !important;
    }

    .brand-text-logo {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }

        .brand-text-logo .brand-main {
            font-family: 'Inter', sans-serif;
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 3px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .brand-text-logo .brand-sub {
            font-family: 'Inter', sans-serif;
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: 3.5px;
            color: var(--emdad-gold-light);
            text-transform: uppercase;
            margin-top: 4px;
        }

    #emdadMainNav .emdad-nav-link {
        color: #ffffff !important;
        font-family: var(--font-body) !important;
        font-size: 13.5px !important;
        font-weight: 600 !important;
        padding: 0.6rem 0.85rem !important;
        transition: color 0.2s ease !important;
        position: relative !important;
    }

        #emdadMainNav .emdad-nav-link:hover,
        #emdadMainNav .emdad-nav-link.active {
            color: var(--emdad-gold-light) !important;
        }

    @@media (min-width: 992px) {
        #emdadMainNav .emdad-nav-link.active::after,
        #emdadMainNav .emdad-nav-link:hover::after {
            content: '' !important;
            position: absolute !important;
            bottom: 2px !important;
            left: 12px !important;
            right: 12px !important;
            height: 2.5px !important;
            background: var(--emdad-gold) !important;
            border-radius: 2px !important;
        }
    }

    #emdadMainNav .emdad-search {
        display: none !important;
    }

    .nav-header-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .lang-switch-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .lang-switch-btn:hover {
            background: rgba(255, 255, 255, 0.15);
            color: var(--emdad-gold-light);
            border-color: var(--emdad-gold);
        }

        .lang-switch-btn i {
            color: var(--emdad-gold-light);
            font-size: 13px;
        }

    .btn-quote-header {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%);
        color: #061d33 !important;
        font-size: 13px;
        font-weight: 800;
        padding: 9px 18px;
        border-radius: 5px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
        transition: all 0.25s ease;
        white-space: nowrap;
    }

        .btn-quote-header:hover {
            background: linear-gradient(135deg, #ffffff 0%, #f5d47a 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
            color: #041424 !important;
        }

    /* ══════════════════════════════════════════════════════════
       HOMEPAGE ROOT WRAPPER
       ══════════════════════════════════════════════════════════ */
    .emdad-home-root {
        font-family: var(--font-body);
        color: var(--emdad-ink);
        background: #ffffff;
        width: 100%;
        overflow-x: hidden;
    }

        .emdad-home-root * {
            box-sizing: border-box;
        }

        .emdad-home-root a {
            text-decoration: none;
            color: inherit;
        }

    .emdad-wrap {
        width: min(1200px, 92%);
        margin: 0 auto;
    }

    /* ══════════════════════════════════════════════════════════
       1. HERO SECTION (High Transparency on Image Side)
       ══════════════════════════════════════════════════════════ */
    .emdad-hero {
        position: relative;
        min-height: clamp(540px, 76vh, 680px);
        display: flex;
        align-items: center;
        color: #ffffff;
        background: #041a30;
        overflow: hidden;
    }

    .emdad-hero-bg-img {
        position: absolute;
        inset: 0;
        background-image: url('/assets/custom/home-images/hero-bg.jpg');
        background-size: cover;
        background-position: center right;
        opacity: 0.92; /* High opacity so picture is bright and clearly visible */
        z-index: 1;
    }

    .emdad-hero-gradient {
        position: absolute;
        inset: 0;
        z-index: 2;
        /* Dark navy on text side, drops to transparent on photo side */
        background: @(isRtl
                ? "linear-gradient(270deg, rgba(4, 24, 46, 0.98) 0%, rgba(4, 24, 46, 0.92) 36%, rgba(4, 24, 46, 0.55) 54%, rgba(4, 24, 46, 0.10) 78%, rgba(4, 24, 46, 0.0) 100%)"
                : "linear-gradient(90deg, rgba(4, 24, 46, 0.98) 0%, rgba(4, 24, 46, 0.92) 36%, rgba(4, 24, 46, 0.55) 54%, rgba(4, 24, 46, 0.10) 78%, rgba(4, 24, 46, 0.0) 100%)");
    }

    .emdad-hero-content {
        position: relative;
        z-index: 5;
        width: 100%;
        padding: clamp(50px, 8vh, 85px) 0;
    }

    .hero-left-column {
        max-width: 680px;
    }

    .hero-eyebrow {
        display: inline-block;
        color: var(--emdad-gold-light);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: @(isRtl ? "1px" : "3px");
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .hero-main-title {
        font-family: var(--font-heading);
        font-size: clamp(34px, 4.4vw, 56px);
        font-weight: 700;
        line-height: 1.12;
        margin-bottom: 18px;
        color: #ffffff;
    }

        .hero-main-title .gold-accent {
            color: var(--emdad-gold-light);
            display: inline;
        }

    .hero-sub-text {
        font-size: clamp(15px, 1.2vw, 18px);
        line-height: 1.65;
        color: rgba(255, 255, 255, 0.88);
        max-width: 600px;
        margin-bottom: 30px;
    }

    .hero-actions-row {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 38px;
    }

    .btn-hero-gold {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%);
        color: #061d33 !important;
        font-size: 14px;
        font-weight: 800;
        padding: 13px 26px;
        border-radius: 5px;
        box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
        transition: all 0.25s ease;
    }

        .btn-hero-gold:hover {
            background: linear-gradient(135deg, #ffffff 0%, #f5d47a 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(212, 175, 55, 0.5);
        }

    .btn-hero-outline {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(4, 26, 48, 0.65);
        color: #ffffff !important;
        font-size: 14px;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 5px;
        border: 1.5px solid rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(6px);
        transition: all 0.25s ease;
    }

        .btn-hero-outline:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: #ffffff;
            color: #ffffff !important;
        }

    /* 4 Feature Badges Under Hero Text: Strictly in 1 Row */
    .hero-badges-row {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        gap: 22px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        padding-top: 22px;
    }

    .hero-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: @(isRtl ? "0" : "1px");
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.92);
        white-space: nowrap;
    }

        .hero-badge-pill i {
            color: var(--emdad-gold-light);
            font-size: 15px;
            flex-shrink: 0;
        }

    /* ══════════════════════════════════════════════════════════
       1.5 CORPORATE IDENTITY (VISION, MISSION, VALUES, QUALITY)
       ══════════════════════════════════════════════════════════ */
    .emdad-identity-section {
        background: #031424;
        padding: clamp(55px, 6vw, 85px) 0;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

        .emdad-identity-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 50% 25%, rgba(11, 58, 103, 0.45) 0%, rgba(3, 20, 36, 0.98) 75%);
            pointer-events: none;
        }

    .identity-row-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        position: relative;
        z-index: 2;
        margin-bottom: 24px;
    }

        .identity-row-grid:last-child {
            margin-bottom: 0;
        }

    .identity-card {
        background: linear-gradient(145deg, rgba(6, 35, 63, 0.94) 0%, rgba(3, 20, 36, 0.98) 100%);
        border: 1.5px solid rgba(212, 175, 55, 0.35);
        border-radius: 8px;
        padding: 32px 28px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
        transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
        display: flex;
        flex-direction: column;
    }

        .identity-card:hover {
            transform: translateY(-4px);
            border-color: rgba(212, 175, 55, 0.7);
            box-shadow: 0 12px 36px rgba(212, 175, 55, 0.16);
        }

    .identity-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 18px;
    }

    .identity-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(212, 175, 55, 0.12);
        border: 2px solid var(--emdad-gold);
        color: var(--emdad-gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
        box-shadow: 0 0 16px rgba(212, 175, 55, 0.25);
    }

    .identity-card-titles {
        display: flex;
        flex-direction: column;
    }

    .identity-card-title {
        font-family: var(--font-heading);
        font-size: clamp(20px, 2.2vw, 25px);
        font-weight: 800;
        color: var(--emdad-gold-light);
        line-height: 1.2;
        margin: 0;
        letter-spacing: @(isRtl ? "0" : "1px");
        text-transform: uppercase;
    }

    .identity-card-desc {
        font-family: var(--font-body);
        font-size: 14.5px;
        line-height: 1.85;
        color: rgba(255, 255, 255, 0.92);
        margin-bottom: 0;
        font-weight: 500;
    }

    /* Values Card Specifics */
    .values-badges-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px 14px;
        margin-top: 4px;
    }

    .value-badge-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(212, 175, 55, 0.28);
        border-radius: 6px;
        padding: 11px 15px;
        transition: all 0.25s ease;
    }

        .value-badge-item:hover {
            background: rgba(212, 175, 55, 0.12);
            border-color: var(--emdad-gold);
            transform: translateX( @(isRtl ? "-4px" : "4px") );
        }

    .value-badge-check {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--emdad-gold);
        color: #041628;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 900;
        flex-shrink: 0;
    }

    .value-badge-text {
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.5px;
    }

    /* Quality Card High-Contrast White / Slate Style */
    .identity-card.quality-card {
        background: linear-gradient(145deg, #ffffff 0%, #f4f7fb 100%);
        border: 1.5px solid rgba(6, 39, 71, 0.25);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
    }

        .identity-card.quality-card .identity-card-icon {
            background: rgba(6, 39, 71, 0.08);
            border-color: var(--emdad-navy);
            color: var(--emdad-navy);
        }

        .identity-card.quality-card .identity-card-title {
            color: var(--emdad-navy);
        }

        .identity-card.quality-card .identity-card-desc {
            color: #1e2d3d;
            font-weight: 600;
        }

    /* ══════════════════════════════════════════════════════════
       2. 4 SECTORS SECTION (Separated Cards with White BG Around)
       ══════════════════════════════════════════════════════════ */
    .emdad-sectors-section {
        background: #ffffff;
        padding: 48px 0 54px;
    }

    .sectors-section-header {
        text-align: center;
        margin-bottom: 34px;
    }

    .sectors-eyebrow {
        display: inline-block;
        color: #b89228;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .sectors-main-title {
        font-family: var(--font-heading);
        font-size: clamp(26px, 3.2vw, 38px);
        font-weight: 800;
        color: var(--emdad-ink);
        line-height: 1.2;
        margin-bottom: 12px;
    }

    .sectors-header-divider {
        width: 50px;
        height: 3px;
        background: linear-gradient(90deg, var(--emdad-gold), var(--emdad-gold-light));
        border-radius: 2px;
        margin: 0 auto 14px;
    }

    .sectors-sub-text {
        font-size: 14.5px;
        line-height: 1.65;
        color: var(--emdad-muted);
        max-width: 680px;
        margin: 0 auto;
    }

    .emdad-sectors-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .sector-tile {
        background: #06233f;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(4, 26, 50, 0.08);
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
    }

        .sector-tile:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(4, 26, 50, 0.16);
        }

    .sector-tile-img-box {
        height: 180px;
        width: 100%;
        overflow: hidden;
        position: relative;
        background: #041a30;
    }

        .sector-tile-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.45s ease;
        }

    .sector-tile:hover .sector-tile-img-box img {
        transform: scale(1.06);
    }

    .sector-tile-body {
        background: #06233f;
        padding: 20px 18px;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .sector-tile-head {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 11px;
    }

    .sector-tile-icon {
        font-size: 24px;
        color: var(--emdad-gold-light);
        flex-shrink: 0;
        line-height: 1;
    }

    .sector-tile-title {
        font-family: var(--font-heading);
        font-size: 15px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.3;
    }

    .sector-tile-desc {
        font-size: 12px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.76);
        margin-bottom: 16px;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .sector-tile-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--emdad-gold-light);
        transition: gap 0.2s ease;
    }

    .sector-tile:hover .sector-tile-link {
        gap: 9px;
        color: #ffffff;
    }

    /* ══════════════════════════════════════════════════════════
       3. STATS BAR (Horizontal: Icon & Text on the Same Line)
       ══════════════════════════════════════════════════════════ */
    .emdad-stats-bar {
        background: #062747;
        color: #ffffff;
        padding: 24px 0;
    }

    .stats-bar-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        align-items: center;
    }

    .stat-box {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 6px 14px;
        border-inline-end: 1px solid rgba(255, 255, 255, 0.15);
    }

        .stat-box:last-child {
            border-inline-end: none;
        }

    .stat-box-icon {
        font-size: 32px;
        color: var(--emdad-gold-light);
        flex-shrink: 0;
        line-height: 1;
    }

    .stat-box-text {
        display: flex;
        flex-direction: column;
        text-align: start;
    }

    .stat-box-num {
        font-size: clamp(22px, 2.2vw, 28px);
        font-weight: 800;
        color: #ffffff;
        line-height: 1.1;
        margin-bottom: 3px;
    }

    .stat-box-label {
        font-size: 11px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.72);
        letter-spacing: @(isRtl ? "0" : "0.5px");
        line-height: 1.25;
    }

    /* ══════════════════════════════════════════════════════════
       4. WHY EMDAD SECTION
       ══════════════════════════════════════════════════════════ */
    .emdad-why-section {
        background: #ffffff;
        padding: clamp(65px, 8vw, 95px) 0;
    }

    .why-section-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: clamp(40px, 6vw, 80px);
        align-items: start;
    }

    .why-left-content h2 {
        font-family: var(--font-heading);
        font-size: clamp(26px, 3.2vw, 38px);
        font-weight: 800;
        color: var(--emdad-ink);
        line-height: 1.2;
        margin-bottom: 16px;
    }

    .why-left-content p {
        font-size: 14px;
        line-height: 1.85;
        color: var(--emdad-body);
    }

    .why-features-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    .why-feature-item {
        text-align: center;
    }

    .why-feature-icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid rgba(212, 175, 55, 0.35);
        background: #f8fafc;
        color: var(--emdad-navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 16px;
        transition: all 0.35s var(--ease-smooth);
    }

    .why-feature-item:hover .why-feature-icon-circle {
        background: var(--emdad-navy);
        color: var(--emdad-gold-light);
        border-color: var(--emdad-navy);
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(6, 39, 71, 0.2);
    }

    .why-feature-title {
        font-size: 14px;
        font-weight: 800;
        color: var(--emdad-ink);
        margin-bottom: 8px;
    }

    .why-feature-desc {
        font-size: 12px;
        line-height: 1.65;
        color: var(--emdad-muted);
    }

    /* ══════════════════════════════════════════════════════════
       5. STRATEGIC PARTNERS STRIP
       ══════════════════════════════════════════════════════════ */
    .emdad-partners-strip {
        background: #f4f6f9;
        border-top: 1px solid var(--emdad-border);
        border-bottom: 1px solid var(--emdad-border);
        padding: 34px 0;
    }

    .partners-strip-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }

    .partners-strip-label {
        font-size: 13px;
        font-weight: 800;
        color: var(--emdad-ink);
        text-transform: uppercase;
        letter-spacing: @(isRtl ? "0" : "1px");
        white-space: nowrap;
        position: relative;
        padding-inline-end: 18px;
    }

        .partners-strip-label::after {
            content: '—';
            margin-inline-start: 12px;
            color: var(--emdad-gold);
