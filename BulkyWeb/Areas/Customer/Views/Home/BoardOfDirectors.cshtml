<!-- DIALOG MODAL CONTAINER -->
<div id="customMemberDialog" class="image-dialog-overlay" onclick="closeMemberModal(event)">
    <div class="image-dialog-content">
        <button class="image-dialog-close" onclick="forceCloseMemberModal()">&times;</button>
        <div class="dialog-img-wrapper">
            <img id="dialogImageTarget" src="" alt="Member Image" />
        </div>
        <div class="dialog-details">
            <div id="dialogRoleTarget" class="dialog-role"></div>
            <h3 id="dialogNameTarget" class="dialog-name"></h3>
            <div id="dialogPositionTarget" class="dialog-position"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function openMemberModal(cardElement) {
        const imgSrc = cardElement.querySelector('.member-photo img').src;
        const role = cardElement.querySelector('.member-role') ? cardElement.querySelector('.member-role').innerText : '';
        const name = cardElement.querySelector('.member-name') ? cardElement.querySelector('.member-name').innerText : '';
        const position = cardElement.querySelector('.member-position') ? cardElement.querySelector('.member-position').innerText : '';

        document.getElementById('dialogImageTarget').src = imgSrc;
        document.getElementById('dialogRoleTarget').innerText = role;
        document.getElementById('dialogNameTarget').innerText = name;
        document.getElementById('dialogPositionTarget').innerText = position;

        const modalOverlay = document.getElementById('customMemberDialog');
        modalOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeMemberModal(event) {
        if (event.target.id === 'customMemberDialog') {
            forceCloseMemberModal();
        }
    }

    function forceCloseMemberModal() {
        const modalOverlay = document.getElementById('customMemberDialog');
        modalOverlay.classList.remove('active');
        document.body.style.overflow = 'auto';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            forceCloseMemberModal();
        }
    });
    </script>
}