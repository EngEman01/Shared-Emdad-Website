@{
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    ViewData["Title"] = "Board Of Directors";
}

<style>
    /* =========================================================
           EMDAD - BOARD OF DIRECTORS (MODERN LUXURY DESIGN)
           ========================================================= */

    :root {
        --emdad-navy-dark: #031427;
        --emdad-navy-main: #062247;
        --emdad-navy-light: #0d3463;
        --emdad-gold-main: #cda871;
        --emdad-gold-light: #e5d1ae;
        --emdad-text-white: #ffffff;
        --emdad-text-muted: #94a3b8;
        --emdad-border-gold: rgba(205, 168, 113, 0.25);
        --emdad-card-bg: rgba(6, 34, 71, 0.75);
    }

    /* Page Container */
    .board-page {
        position: relative;
        width: 100%;
        min-height: 100vh;
        background-color: var(--emdad-navy-dark);
        background-image: radial-gradient(circle at 15% 15%, rgba(205, 168, 113, 0.08) 0%, transparent 40%), radial-gradient(circle at 85% 60%, rgba(13, 52, 99, 0.3) 0%, transparent 45%);
        color: var(--emdad-text-white);
        overflow: hidden;
    }

    /* =========================================================
           HERO SECTION
           ========================================================= */
    .board-hero {
        position: relative;
        padding: clamp(60px, 8vh, 120px) 0 clamp(40px, 5vh, 80px);
        background: linear-gradient(180deg, rgba(3, 20, 39, 0.85) 0%, rgba(3, 20, 39, 0.95) 100%), url('/assets/custom/BG/bg4.png') center/cover no-repeat;
        border-bottom: 1px solid var(--emdad-border-gold);
    }

        .board-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(205, 168, 113, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(205, 168, 113, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
            pointer-events: none;
        }

    .board-hero-content {
        position: relative;
        z-index: 2;
        width: min(90%, 1400px);
        margin: 0 auto;
        text-align: center;
    }

    .board-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--emdad-gold-main);
        font-size: clamp(12px, 0.85vw, 15px);
        font-weight: 700;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

        .board-eyebrow::before,
        .board-eyebrow::after {
            content: "";
            width: 30px;
            height: 1px;
            background: var(--emdad-gold-main);
        }

    .board-title {
        margin: 0;
        font-size: clamp(36px, 4.5vw, 72px);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--emdad-text-white);
    }

        .board-title span {
            display: block;
            margin-top: 10px;
            font-size: clamp(16px, 1.8vw, 28px);
            font-weight: 400;
            color: var(--emdad-gold-light);
            letter-spacing: 0.05em;
        }

    .board-description {
        max-width: 800px;
        margin: 24px auto 0;
        color: var(--emdad-text-muted);
        font-size: clamp(15px, 1.05vw, 19px);
        line-height: 1.8;
    }

    /* =========================================================
           BOARD MEMBERS SECTION & GRID
           ========================================================= */
    .board-section {
        position: relative;
        padding: clamp(50px, 6vw, 100px) 0;
    }

    .board-section-header {
        width: min(90%, 1400px);
        margin: 0 auto clamp(40px, 4vw, 60px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 20px;
    }

    .board-section-title {
        font-size: clamp(24px, 2vw, 36px);
        font-weight: 700;
        color: var(--emdad-text-white);
        margin: 0;
        position: relative;
    }

        .board-section-title::after {
            content: "";
            position: absolute;
            bottom: -21px;
            left: 0;
            width: 60px;
            height: 3px;
            background: var(--emdad-gold-main);
            border-radius: 2px;
        }

    .board-count {
        color: var(--emdad-gold-main);
        font-size: clamp(12px, 0.9vw, 15px);
        font-weight: 600;
        letter-spacing: 0.15em;
    }

    .board-grid {
        width: min(90%, 1400px);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: clamp(20px, 2.5vw, 35px);
    }

    /* =========================================================
           MEMBER CARD DESIGN
           ========================================================= */
    .board-member {
        position: relative;
        background: var(--emdad-card-bg);
        border: 1px solid var(--emdad-border-gold);
        border-radius: 12px;
        backdrop-filter: blur(10px);
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), border-color 0.4s ease, box-shadow 0.4s ease;
        display: flex;
        flex-direction: column;
    }

        .board-member:hover {
            transform: translateY(-8px);
            border-color: var(--emdad-gold-main);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(205, 168, 113, 0.15);
        }

    .member-number {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        background: rgba(3, 20, 39, 0.75);
        border: 1px solid var(--emdad-border-gold);
        color: var(--emdad-gold-main);
        font-size: 12px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    .member-photo {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1.15;
        overflow: hidden;
        background: var(--emdad-navy-dark);
    }

        .member-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
            filter: grayscale(15%) contrast(105%);
            transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1), filter 0.6s ease;
        }

    .board-member:hover .member-photo img {
        transform: scale(1.06);
        filter: grayscale(0%) contrast(100%);
    }

    .member-photo::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, var(--emdad-navy-main) 0%, transparent 60%);
        pointer-events: none;
    }

    .expand-overlay {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(3, 20, 39, 0.4);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .board-member:hover .expand-overlay {
        opacity: 1;
    }

    .expand-btn-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--emdad-gold-main);
        color: var(--emdad-navy-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        transform: scale(0.8);
        transition: transform 0.3s ease;
    }

    .board-member:hover .expand-btn-icon {
        transform: scale(1);
    }

    .member-info {
        padding: 20px clamp(16px, 1.5vw, 24px) 24px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .member-role {
        display: inline-block;
        color: var(--emdad-gold-main);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .member-name {
        margin: 0 0 6px;
        color: var(--emdad-text-white);
        font-size: clamp(17px, 1.2vw, 20px);
        font-weight: 700;
        line-height: 1.3;
    }

    .member-position {
        color: var(--emdad-text-muted);
        font-size: clamp(13px, 0.9vw, 14px);
        line-height: 1.5;
        margin-top: auto;
    }

    /* =========================================================
           CUSTOM MODAL DIALOG
           ========================================================= */
    .image-dialog-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(3, 20, 39, 0.88);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

        .image-dialog-overlay.active {
            opacity: 1;
            visibility: visible;
        }

    .image-dialog-content {
        position: relative;
        width: min(92%, 520px);
        background: var(--emdad-navy-main);
        border: 1px solid var(--emdad-gold-main);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(205, 168, 113, 0.2);
        transform: scale(0.9);
        transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .image-dialog-overlay.active .image-dialog-content {
        transform: scale(1);
    }

    .image-dialog-close {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(3, 20, 39, 0.8);
        border: 1px solid var(--emdad-border-gold);
        color: var(--emdad-text-white);
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .image-dialog-close:hover {
            background: var(--emdad-gold-main);
            color: var(--emdad-navy-dark);
        }

    .dialog-img-wrapper {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
        background: var(--emdad-navy-dark);
    }

        .dialog-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

    .dialog-details {
        padding: 24px;
        text-align: center;
    }

    .dialog-role {
        color: var(--emdad-gold-main);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .dialog-name {
        font-size: 22px;
        font-weight: 800;
        color: var(--emdad-text-white);
        margin: 0 0 8px;
    }

    .dialog-position {
        font-size: 15px;
        color: var(--emdad-text-muted);
        line-height: 1.5;
    }

    /* Responsive Grid Tweaks */
    @@media (max-width: 768px) {
        .board-grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
        }

        .board-section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

