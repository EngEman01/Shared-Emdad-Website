<style>

    /* =========================================================
       EMDAD - BOARD OF DIRECTORS
       COMMAND GRID DESIGN
       ========================================================= */

    :root {
        --emdad-navy: #042147;
        --emdad-navy-2: #071a31;
        --emdad-navy-3: #0b2948;
        --emdad-gold: #bda378;
        --emdad-gold-light: #d7c49d;
        --emdad-white: #ffffff;
        --emdad-muted: #aab7c6;
        --emdad-border: rgba(189, 163, 120, .28);
        --emdad-shadow: rgba(0, 0, 0, .35);
    }

    /* =========================================================
       PAGE
       ========================================================= */

    .board-page {
        position: relative;
        width: 100%;
        overflow: hidden;
        background:
            radial-gradient(circle at 10% 10%, rgba(189,163,120,.08), transparent 25%),
            radial-gradient(circle at 90% 30%, rgba(13,65,105,.25), transparent 30%),
            var(--emdad-navy-2);
    }


    /* =========================================================
       HERO
       ========================================================= */

    .board-hero {
        position: relative;
        min-height: clamp(320px, 42vh, 620px);
        display: flex;
        align-items: center;
        overflow: hidden;

        background:
            linear-gradient(
                90deg,
                rgba(4,33,71,.98) 0%,
                rgba(4,33,71,.88) 45%,
                rgba(4,33,71,.65) 100%
            ),
            url('/assets/custom/BG/bg4.png');

        background-size: cover;
        background-position: center;
    }


    /* Engineering lines */

    .board-hero::before {
        content: "";
        position: absolute;
        inset: 0;

        background-image:
            linear-gradient(
                rgba(189,163,120,.08) 1px,
                transparent 1px
            ),
            linear-gradient(
                90deg,
                rgba(189,163,120,.08) 1px,
                transparent 1px
            );

        background-size:
            70px 70px,
            70px 70px;

        mask-image: linear-gradient(
            to right,
            black,
            transparent 85%
        );

        pointer-events: none;
    }


    /* Gold vertical line */

    .board-hero::after {
        content: "";

        position: absolute;

        left: clamp(20px, 7vw, 140px);
        top: 15%;
        bottom: 15%;

        width: 2px;

        background:
            linear-gradient(
                transparent,
                var(--emdad-gold),
                transparent
            );

        opacity: .8;
    }


    .board-hero-content {
        position: relative;
        z-index: 2;

        width: min(92%, 1600px);

        margin: auto;

        padding:
            clamp(50px, 7vw, 120px)
            0;
    }


    .board-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;

        margin-bottom: 20px;

        color: var(--emdad-gold);

        font-size: clamp(11px, .8vw, 17px);

        font-weight: 700;

        letter-spacing: .22em;

        text-transform: uppercase;
    }


    .board-eyebrow::before {
        content: "";

        width: clamp(30px, 3vw, 65px);
        height: 2px;

        background: var(--emdad-gold);
    }


    .board-title {
        margin: 0;

        color: #fff;

        font-size: clamp(42px, 5.5vw, 100px);

        line-height: .95;

        font-weight: 800;

        letter-spacing: -.04em;
    }


    .board-title span {
        display: block;

        margin-top: 12px;

        color: var(--emdad-gold);

        font-size: .48em;

        font-weight: 400;

        letter-spacing: .08em;
    }


    .board-description {
        max-width: 850px;

        margin-top: 30px;

        color: rgba(255,255,255,.75);

        font-size: clamp(14px, 1.1vw, 21px);

        line-height: 1.9;
    }


    /* =========================================================
       BOARD AREA
       ========================================================= */

    .board-section {
        position: relative;

        padding:
            clamp(55px, 7vw, 120px)
            clamp(18px, 5vw, 100px);

        /* background:
            linear-gradient(
                180deg,
                #06182c 0%,
                #041326 100%
            ); */

            background:#ffffff;
    }


    .board-section-header {
        width: min(92%, 1600px);

        margin: 0 auto clamp(35px, 5vw, 75px);

        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 30px;
    }


    .board-section-title {
        color: #fff;

        font-size: clamp(26px, 2.5vw, 48px);

        font-weight: 700;

        margin: 0;
    }


    .board-section-title::after {
        content: "";

        display: block;

        width: clamp(45px, 5vw, 90px);

        height: 3px;

        margin-top: 15px;

        background: var(--emdad-gold);
    }


    .board-count {
        color: var(--emdad-gold);

        font-size: clamp(13px, 1vw, 18px);

        letter-spacing: .12em;

        white-space: nowrap;
    }


    /* =========================================================
       GRID
       ========================================================= */

    .board-grid {

        width: min(92%, 1800px);

        margin: auto;

        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(
                    clamp(260px, 22vw, 390px),
                    1fr
                )
            );

        gap:
            clamp(18px, 2vw, 38px);
    }


    /* =========================================================
       MEMBER CARD
       ========================================================= */

    .board-member {

        position: relative;

        min-width: 0;

        background:
            linear-gradient(
                145deg,
                rgba(11,41,72,.96),
                rgba(4,20,39,.98)
            );

        border: 1px solid var(--emdad-border);

        overflow: hidden;

        transition:
            transform .45s ease,
            border-color .45s ease,
            box-shadow .45s ease;

        box-shadow:
            0 20px 45px rgba(0,0,0,.22);
    }


    /* Corner cut */

    .board-member::before {

        content: "";

        position: absolute;

        top: 0;
        right: 0;

        width: 55px;
        height: 55px;

        border-left: 1px solid var(--emdad-border);
        border-bottom: 1px solid var(--emdad-border);

        background: rgba(189,163,120,.04);

        clip-path: polygon(
            100% 0,
            100% 100%,
            0 0
        );

        z-index: 5;
    }


    /* Gold bottom line */

    .board-member::after {

        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 0;
        height: 3px;

        background: var(--emdad-gold);

        transition: width .5s ease;
    }


    .board-member:hover {

        transform: translateY(-8px);

        border-color:
            rgba(189,163,120,.65);

        box-shadow:
            0 30px 70px rgba(0,0,0,.4);
    }


    .board-member:hover::after {
        width: 100%;
    }


    /* =========================================================
       MEMBER NUMBER
       ========================================================= */

    .member-number {

        position: absolute;

        top: 16px;
        left: 18px;

        z-index: 8;

        color: var(--emdad-gold);

        font-size: clamp(11px, .8vw, 15px);

        font-weight: 700;

        letter-spacing: .12em;
    }


    /* =========================================================
       IMAGE
       ========================================================= */

    .member-photo {

        position: relative;

        aspect-ratio: 4 / 4.25;

        overflow: hidden;

        background: #081d34;
    }


    .member-photo::before {

        content: "";

        position: absolute;

        inset: 0;

        z-index: 2;

        background:
            linear-gradient(
                180deg,
                rgba(4,33,71,.05) 40%,
                rgba(4,20,39,.75) 100%
            );

        pointer-events: none;
    }


    .member-photo::after {

        content: "";

        position: absolute;

        inset: 12px;

        border: 1px solid rgba(255,255,255,.14);

        z-index: 3;

        pointer-events: none;
    }


    .member-photo img {

        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        object-position: center top;

        filter:
            saturate(.82)
            contrast(1.05);

        transition:
            transform .7s cubic-bezier(.2,.7,.2,1),
            filter .7s ease;
    }


    .board-member:hover .member-photo img {

        transform: scale(1.045);

        filter:
            saturate(1)
            contrast(1.08);
    }


    /* =========================================================
       MEMBER INFO
       ========================================================= */

    .member-info {

        position: relative;

        padding:
            clamp(20px, 1.7vw, 32px)
            clamp(18px, 1.8vw, 34px)
            clamp(25px, 2vw, 38px);
    }


    .member-role {

        display: flex;

        align-items: center;

        gap: 10px;

        margin-bottom: 10px;

        color: var(--emdad-gold);

        font-size: clamp(10px, .75vw, 14px);

        font-weight: 700;

        letter-spacing: .1em;

        text-transform: uppercase;
    }


    .member-role::before {

        content: "";

        width: 22px;

        height: 1px;

        background: var(--emdad-gold);
    }


    .member-name {

        margin: 0;

        color: #fff;

        font-size: clamp(17px, 1.35vw, 26px);

        font-weight: 700;

        line-height: 1.35;
    }


    .member-position {

        display: block;

        margin-top: 8px;

        color: var(--emdad-muted);

        font-size: clamp(12px, .9vw, 17px);

        line-height: 1.6;
    }


    /* =========================================================
       COMPANY INFORMATION
       ========================================================= */

    .company-section {

        position: relative;

        padding:
            clamp(55px, 7vw, 110px)
            clamp(18px, 5vw, 100px);

        background:
            #f3f5f7;
    }


    .company-grid {

        width: min(92%, 1600px);

        margin: auto;

        display: grid;

        grid-template-columns:
            repeat(
                auto-fit,
                minmax(
                    min(100%, 300px),
                    1fr
                )
            );

        gap:
            clamp(18px, 2vw, 35px);
    }


    .company-card {

        position: relative;

        padding:
            clamp(25px, 2.5vw, 45px);

        min-height:
            clamp(220px, 18vw, 320px);

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        background: #fff;

        border: 1px solid #e2e7ec;

        overflow: hidden;

        transition:
            transform .4s ease,
            box-shadow .4s ease;
    }


    .company-card:hover {

        transform: translateY(-8px);

        box-shadow:
            0 25px 55px rgba(4,33,71,.12);
    }


    .company-card::before {

        content: "";

        position: absolute;

        top: 0;
        left: 0;

        width: 5px;
        height: 100%;

        background: var(--emdad-navy);
    }


    .company-icon {

        width: clamp(48px, 4vw, 70px);

        height: clamp(48px, 4vw, 70px);

        display: flex;

        align-items: center;
        justify-content: center;

        background:
            var(--emdad-navy);

        color:
            var(--emdad-gold);

        font-size:
            clamp(19px, 1.6vw, 28px);
    }


    .company-card h3 {

        margin:
            clamp(22px, 2vw, 30px)
            0
            10px;

        color: var(--emdad-navy);

        font-size:
            clamp(18px, 1.4vw, 27px);

        font-weight: 700;
    }


    .company-card p {

        margin: 0;

        color: #66717d;

        font-size:
            clamp(13px, .95vw, 17px);

        line-height: 1.85;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 991px) {

        .board-section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .board-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .board-hero::after {
            display: none;
        }
    }


    @@media (max-width: 650px) {

        .board-hero {
            min-height: 360px;
        }

        .board-hero-content {
            width: 88%;
        }

        .board-description {
            line-height: 1.7;
        }

        .board-grid {
            grid-template-columns: 1fr;
            width: 92%;
        }

        .member-photo {
            aspect-ratio: 4 / 4.1;
        }

        .company-grid {
            width: 92%;
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 400px) {

        .board-grid {
            width: 94%;
        }

        .member-info {
            padding: 20px;
        }
    }


    /* =========================================================
       LARGE SCREENS / 4K / 70 INCH TV
       ========================================================= */

    @@media (min-width: 1800px) {

        .board-section-header,
        .board-grid,
        .company-grid {
            width: min(90%, 1900px);
        }

        .board-grid {
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
        }

        .member-photo {
            aspect-ratio: 4 / 4.1;
        }

        .board-section {
            padding-top: 100px;
            padding-bottom: 120px;
        }
    }


    @@media (min-width: 2400px) {

        .board-section-header,
        .board-grid,
        .company-grid {
            width: min(88%, 2200px);
        }

        .board-grid {
            gap: 42px;
        }

        .member-photo {
            aspect-ratio: 4 / 4;
        }
    }


    /* =========================================================
       MOTION
       ========================================================= */

    .board-reveal {

        opacity: 0;

        transform:
            translateY(25px);

        transition:
            opacity .7s ease,
            transform .7s ease;
    }


    .board-reveal.visible {

        opacity: 1;

        transform:
            translateY(0);
    }


    @@media (prefers-reduced-motion: reduce) {

        .board-member,
        .board-member img,
        .company-card,
        .board-reveal {
            transition: none !important;
        }
    }

</style>


