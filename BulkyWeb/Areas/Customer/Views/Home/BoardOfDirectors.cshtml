<style>
/* Member Cards */
.member-card {
    cursor: pointer;
    transition: transform 0.3s;
}
.member-card:hover {
    transform: translateY(-10px);
}
.member-img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    margin-top: 20px;
    transition: transform 0.3s;
}
.member-card:hover .member-img {
    transform: scale(1.1);
}
.member-overlay {
    background: rgba(0,0,0,0.4);
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: 50%;
}
.member-card:hover .member-overlay {
    opacity: 1;
}

/* Info Cards */
.hover-scale {
    transition: transform 0.3s, box-shadow 0.3s;
}
.hover-scale:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.15);
}

/* Hero Section */
.hero-board {
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.board-creative {
    background: linear-gradient(135deg,#f4f8ff,#ffffff);
}

/* Card */
.creative-card {
    position: relative;
    padding: 6px;
    border-radius: 40% 60% 55% 45% / 60% 40% 60% 40%;
    background: linear-gradient(135deg,#042147,#0a3b7a);
    transition: 0.6s ease;
    animation: drift 8s linear infinite;
    cursor: pointer;
}

/* Smooth Continuous Drift */
@@keyframes drift {
    0%   { transform: translate(0px, 0px) rotate(0deg); }
    25%  { transform: translate(6px, -8px) rotate(1deg); }
    50%  { transform: translate(0px, -12px) rotate(0deg); }
    75%  { transform: translate(-6px, -8px) rotate(-1deg); }
    100% { transform: translate(0px, 0px) rotate(0deg); }
}


/* Inner content */
.creative-img {
    background:#fff;
    border-radius: inherit;
    overflow: hidden;
}

.creative-img img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: top;
    transition: 0.6s ease;
}

/* Info */
.creative-info {
    text-align: center;
    padding: 15px 10px 20px;
    background:#fff;
    border-radius: 0 0 40% 60% / 0 0 60% 40%;
}

.creative-info h6 {
    font-weight: 600;
    margin-bottom: 4px;
    color:#042147;
    font-size:14px;
}

.creative-info span {
    font-size:13px;
    color:#666;
}

/* Hover effect */
.creative-card:hover {
    transform: rotate(-2deg) scale(1.05);
}

.creative-card:hover img {
    transform: scale(1.1);
}
.modern-info {
    background: #f8fbff;
}

.modern-card {
    position: relative;
    padding: 40px 30px;
    background: #fff;
    border-radius: 20px 60px 20px 60px;
    overflow: hidden;
    transition: 0.5s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    cursor: pointer;
}

/* الخط الجانبي */
.modern-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    background: #042147;
    transition: 0.5s ease;
}

/* الأيقونة الخلفية */
.modern-card .icon-bg {
    position: absolute;
    right: -20px;
    top: -20px;
    font-size: 120px;
    color: rgba(4, 33, 71, 0.05);
    transition: 0.6s ease;
}

/* النص */
.modern-card h5 {
    font-weight: 700;
    margin-bottom: 15px;
    color: #042147;
}

.modern-card p {
    color: #6c757d;
    font-size: 15px;
    line-height: 1.7;
}

/* Hover Effect مبهر */
.modern-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 45px rgba(4,33,71,0.15);
}

.modern-card:hover::before {
    width: 100%;
    opacity: 0.05;
}

.modern-card:hover .icon-bg {
    transform: rotate(15deg) scale(1.2);
    color: rgba(4,33,71,0.1);
}


</style>
