@section Scripts {
<script>
    // Certificate Modal Functions
    function openCertModal(modalId) {
        var modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeCertModal(modalId) {
        var modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
    }

    function closeCertModalOnOutside(e, modalId) {
        if (e.target && e.target.classList.contains('quality-modal')) {
            closeCertModal(modalId);
        }
    }

    // Direct, reliable file download helper
    function downloadCertificateFile(url, filename) {
        fetch(url)
            .then(function (response) {
                if (!response.ok) throw new Error('Download failed');
                return response.blob();
            })
            .then(function (blob) {
                var link = document.createElement('a');
                var blobUrl = window.URL.createObjectURL(blob);
                link.href = blobUrl;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                setTimeout(function () {
                    window.URL.revokeObjectURL(blobUrl);
                    document.body.removeChild(link);
                }, 200);
            })
            .catch(function () {
                var a = document.createElement('a');
                a.href = url;
                a.setAttribute('download', filename);
                a.target = '_blank';
                document.body.appendChild(a);
                a.click();
                setTimeout(function () {
                    document.body.removeChild(a);
                }, 200);
            });
    }

    // Global ESC key and keyboard support
    document.addEventListener('DOMContentLoaded', function () {
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.quality-modal.active').forEach(function (m) {
                    m.classList.remove('active');
                });
                document.body.style.overflow = '';
            }
        });

        // Add Enter key accessibility for frames
        document.querySelectorAll('.gold-cert-frame').forEach(function (frame) {
            frame.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    frame.click();
                }
            });
        });
    });
</script>
}