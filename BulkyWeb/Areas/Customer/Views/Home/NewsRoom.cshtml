@model HomeVM

@{
	ViewData["Title"] = "Home Page";
	IEnumerable<Category> mainCategories = ViewBag.MainCategories;
}


<div class="emdad-header emdad-after-overlay overlay-lighter bg-rules"
	 style="background-image: url('/assets/custom/Board Of Directors/Board Of Directors.jpg'); direction:ltr; background-attachment: fixed;">
	<div class="container overflow-hidden">
		<div class="owl-carousel  default-carousel emdad-sqr-nav dots-0 wow fadeInUpBig" style="text-align: center;"
			 data-wow-duration="2s">
			<div>
				<h1 class="white-color bold-font mt-lg-5 mb-4">
					<span class="text-white">
						@localizer["WelcomeNewsRoom"]
						<br />
					</span>
				</h1>
				<p class="text-white font-20">
					@localizer["WelcomeNewsRoomContent"]
				</p>

			</div>

		</div>
	</div>
</div>

