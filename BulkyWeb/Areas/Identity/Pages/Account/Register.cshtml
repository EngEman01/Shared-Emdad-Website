@page
@model RegisterModel
@{
	ViewData["Title"] = "Register";
}


<div class="styleRegisterPage">

    <div class="space">
    </div>

    <div class="container wow fadeInLeftBig">
        <div class="header">
            <h2>عمل حساب</h2>
        </div>
        <form id="formElement" class="form">
            <div class="style-inputs">
                <div class="form-control">
                    <label for="username">الاسم الاول</label>
                    <input type="text" placeholder="الاسم الاول" id="username" required />
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
                <div class="form-control">
                    <label for="lastname">الاسم الاخير</label>
                    <input type="text" placeholder="الاسم الاخير" id="lastname" required />
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
            </div>
            <div class="form-control">
                <label for="email">البريد الالكتروني</label>
                <input type="email" placeholder="a@florin-pop.com" id="email" />
                <i class="fas fa-check-circle"></i>
                <i class="fas fa-exclamation-circle"></i>
                <small>Error message</small>
            </div>
            <!-- <div class="form-control">
                <label for="email">تأكيد البريد الالكتروني</label>
                <input type="email" placeholder="a@florin-pop.com" id="email2" />
                <i class="fas fa-check-circle"></i>
                <i class="fas fa-exclamation-circle"></i>
                <small>Error message</small>
            </div> -->
            <div class="style-inputs">
                <div class="form-control">
                    <select class="emdad-form-control rounded-0 py-3 pl-5 font-13 sign-register-input" id="country">
                        <option value="">اختر الدولة</option>
                        <option value="السعودية">السعودية</option>
                        <option value="الإمارات">الإمارات</option>
                        <option value="مصر">مصر</option>
                        <option value="الولايات المتحدة الأمريكية">الولايات المتحدة الأمريكية</option>
                        <option value="كندا">كندا</option>
                        <option value="المملكة المتحدة">المملكة المتحدة</option>
                        <option value="ألمانيا">ألمانيا</option>
                        <option value="فرنسا">فرنسا</option>
                        <option value="إيطاليا">إيطاليا</option>
                        <option value="أستراليا">أستراليا</option>
                        <option value="البرازيل">البرازيل</option>
                        <option value="الهند">الهند</option>
                        <option value="الجزائر">الجزائر</option>
                        <option value="روسيا">روسيا</option>
                        <option value="الصين">الصين</option>
                        <option value="اليابان">اليابان</option>
                        <option value="المكسيك">المكسيك</option>
                        <option value="جنوب أفريقيا">جنوب أفريقيا</option>
                        <option value="إسبانيا">إسبانيا</option>
                        <option value="تركيا">تركيا</option>
                        <option value="اليونان">اليونان</option>
                        <option value="لبنان">لبنان</option>
                        <option value="الأردن">الأردن</option>
                        <option value="فلسطين">فلسطين</option>
                        <option value="العراق">العراق</option>
                        <option value="سوريا">سوريا</option>
                        <option value="الكويت">الكويت</option>
                        <option value="عمان">عمان</option>
                        <option value="اليمن">اليمن</option>
                        <option value="تونس">تونس</option>
                        <option value="المغرب">المغرب</option>
                        <option value="ليبيا">ليبيا</option>
                        <option value="موريتانيا">موريتانيا</option>
                        <option value="البحرين">البحرين</option>
                        <option value="السودان">السودان</option>
                        <option value="جزر القمر">جزر القمر</option>

                    </select>
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>


                <div class="form-control">
                    <select class="emdad-form-control rounded-0 py-3 pl-5 font-13 sign-register-input" id="city">
                        <option value="">اختر المدينة</option>

                    </select>
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
            </div>

            <div class="style-inputs">

                <div class="form-control1 iti">
                    <label for="phone">الهاتف</label>
                    <input type="tel" placeholder="0102-456-7890" id="phone" name="phone" class="format-phone" />
                    <!-- <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small> -->
                </div>

                <!-- <div class="iti">
                    <input type="tel" name="phone">
                </div> -->
                <div class="form-control">
                    <label for="address">العنوان</label>
                    <input type="text" placeholder="123 Main St" id="address" />
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
            </div>
            <div class="style-inputs">
                <div class="form-control">
                    <label for="password">كلمة المرور</label>
                    <input type="password" placeholder="كلمة المرور" id="password" />
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
                <div class="form-control">
                    <label for="password2">تأكيد كلمة المرور</label>
                    <input type="password" placeholder="تأكيد كلمة المرور" id="password2" />
                    <i class="fas fa-check-circle"></i>
                    <i class="fas fa-exclamation-circle"></i>
                    <small>Error message</small>
                </div>
            </div>
            <button type="submit" id="submit-btn"
                    class="btn btn-block rounded-0 text-white emdad-register-background-color emdad-register-hover-background-color font-16 semi-font py-3">
                سجل الان
            </button>


            <a href="#" style="text-align:center;"
               class="emdad-forth-text-color font-16 emdad-second-hover-color underline mt-3 mb-4 mb-lg-5 d-block">
                نسيت كلمة السر
            </a>

            <p class="emdad-forth-text-color" style="text-align:center;">
                لديك حساب بالفعل / <a href="signin.html"
                                      class="font-16 semi-font emdad-second-text-color underline emdad-main-hover-color ml-2">
                    تسجيل الدخول
                </a>
            </p>
        </form>
    </div>

</div>


