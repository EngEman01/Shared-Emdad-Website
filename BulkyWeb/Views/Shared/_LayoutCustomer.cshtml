<style>

    /* =========================================================
       NAVBAR (Dark Navy Reference Style)
       ========================================================= */

    .emdad-navbar {
        position: sticky;
        top: 0;
        z-index: 2000;
        background: #061d33 !important;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
        padding: 0.65rem 0;
        font-family: @(System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft ? "'Cairo', sans-serif" : "'Inter', -apple-system, sans-serif");
    }

    .emdad-navbar.scrolled {
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
        border-bottom-color: #d4af37;
    }

    /* LOGO */
    .emdad-brand-title {
        display: flex;
        flex-direction: column;
        line-height: 1;
    }
    .emdad-brand-main {
        font-family: 'Inter', sans-serif;
        font-size: 26px;
        font-weight: 900;
        letter-spacing: 3px;
        color: #ffffff;
        text-transform: uppercase;
    }
    .emdad-brand-sub {
        font-family: 'Inter', sans-serif;
        font-size: 8.5px;
        font-weight: 600;
        letter-spacing: 3.5px;
        color: #f3d078;
        text-transform: uppercase;
        margin-top: 4px;
    }

    /* NAV LINKS */
/* NAV LINKS */
.emdad-nav-link {
    color: #ffffff !important;
    font-size: 13.5px;
    font-weight: 600;
    padding: 0.55rem 0.75rem !important;
    position: relative;
    white-space: nowrap;
    transition: color 0.2s ease;
}

.emdad-nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 10px;
    right: 10px;
    height: 2.5px;
    background: #d4af37;
    border-radius: 2px;
    transition: opacity 0.2s ease;
    opacity: 0;
}

/* Hover & Active States */
.emdad-nav-link:hover,
.emdad-nav-link.active {
    color: #f3d078 !important;
}

.emdad-nav-link.active::after,
.emdad-nav-link:hover::after {
    opacity: 1 !important;
}

/* Dropdown Menu Item Active State */
.emdad-navbar .dropdown-item.active {
    background: #fdf8ed !important;
    color: #a47f36 !important;
    font-weight: 700;
}

    /* RIGHT EXTRAS */
    .emdad-lang-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }
    .emdad-lang-pill:hover {
        background: rgba(255, 255, 255, 0.15);
        color: #f3d078;
        border-color: #d4af37;
    }
    .emdad-lang-pill i {
        color: #f3d078;
        font-size: 13px;
    }

    .emdad-btn-quote-header {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%);
        color: #061d33 !important;
        font-size: 13px;
        font-weight: 800;
        padding: 9px 18px;
        border-radius: 5px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
        transition: all 0.25s ease;
        white-space: nowrap;
    }
    .emdad-btn-quote-header:hover {
        background: linear-gradient(135deg, #ffffff 0%, #f5d47a 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
    }

    /* DROPDOWN MENU */
    .emdad-navbar .nav-item.dropdown {
        position: relative;
    }

    .emdad-navbar .dropdown-menu {
        border-radius: 12px;
        padding: 8px;
        background: #ffffff;
        border: 1px solid rgba(4, 33, 71, 0.08);
        box-shadow: 0 15px 40px rgba(4, 33, 71, 0.15);
        min-width: 230px;
    }

    .emdad-navbar .dropdown-item {
        color: #042147;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 8px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }

    .emdad-navbar .dropdown-item:hover {
        background: #fdf8ed;
        color: #a47f36;
        padding-inline-start: 18px;
    }

    /* =========================================================
       SEARCH BAR — Modern underline style
       ========================================================= */
    .emdad-search {
        display: flex;
        align-items: center;
        position: relative;
        height: 40px;
        background: transparent;
        border-bottom: 2px solid rgba(4, 33, 71, 0.25);
        padding: 0 4px;
        gap: 6px;
        transition: border-color 0.3s ease;
        min-width: 170px;
    }

    .emdad-search:focus-within {
        border-bottom-color: #c5a059;
    }

    .emdad-search .search-icon {
        color: #8293a5;
        font-size: 14px;
        flex-shrink: 0;
        transition: color 0.25s ease;
    }

    .emdad-search:focus-within .search-icon {
        color: #c5a059;
    }

    .emdad-search input {
        border: none;
        background: transparent;
        outline: none;
        font-size: 13.5px;
        color: #042147;
        flex: 1;
        font-weight: 500;
        padding: 0;
    }

    .emdad-search input::placeholder {
        color: #aab4be;
    }

    .emdad-search button {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: none;
        background: #c5a059;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: background 0.25s ease, transform 0.2s ease;
        flex-shrink: 0;
    }

    .emdad-search button:hover {
        background: #042147;
        transform: scale(1.08);
    }

    /* Flip arrow for RTL */
    [dir="rtl"] .emdad-search button .fa-arrow-right::before {
        content: "\f060"; /* fa-arrow-left */
    }

    /* =========================================================
       LANGUAGE SWITCHER — Toggle pill
       ========================================================= */
    .emdad-lang-toggle {
        display: inline-flex;
        align-items: center;
        background: #f1f5f9;
        border: 1.5px solid rgba(4, 33, 71, 0.12);
        border-radius: 30px;
        height: 38px;
        padding: 4px 10px;
        gap: 6px;
        transition: border-color 0.3s ease;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .emdad-lang-toggle:hover {
        border-color: #c5a059;
    }

    .emdad-lang-toggle .lang-globe {
        color: #042147;
        font-size: 13px;
        flex-shrink: 0;
    }

    /* Make the nested div and form inside the partial flex so they don't collapse */
    .emdad-lang-toggle > div,
    .emdad-lang-toggle > div > form {
        display: inline-flex;
        align-items: center;
    }

    .emdad-lang-toggle select,
    .emdad-lang-toggle .changeLanguage {
        background: transparent;
        border: none;
        color: #042147;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        outline: none;
        padding: 0 4px;
        appearance: auto;
        -webkit-appearance: auto;
        max-width: 100px;
    }

    .emdad-lang-toggle select option,
    .emdad-lang-toggle .changeLanguage option {
        background: #ffffff;
        color: #042147;
    }


    /* =========================================================
       MOBILE TOGGLE
       ========================================================= */

    .emdad-navbar .navbar-toggler,
    .emdad-mobile-toggler {
        border: 1px solid rgba(212, 175, 55, 0.45) !important;
        background: rgba(255, 255, 255, 0.06) !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        color: #f3d078 !important;
        outline: none !important;
        box-shadow: none !important;
        transition: all 0.25s ease !important;
        cursor: pointer;
    }

    .emdad-navbar .navbar-toggler:hover,
    .emdad-navbar .navbar-toggler:focus,
    .emdad-mobile-toggler:hover,
    .emdad-mobile-toggler:focus {
        background: rgba(212, 175, 55, 0.16) !important;
        border-color: #d4af37 !important;
        box-shadow: 0 0 14px rgba(212, 175, 55, 0.3) !important;
        outline: none !important;
    }

    .emdad-navbar .navbar-toggler i,
    .emdad-mobile-toggler i {
        color: #f3d078 !important;
        font-size: 20px !important;
        display: inline-block !important;
        vertical-align: middle !important;
    }

    /* =========================================================
       MOBILE MENU (Max width 991px)
       ========================================================= */

    @@media (max-width: 991px) {

        .emdad-navbar .navbar-collapse {
