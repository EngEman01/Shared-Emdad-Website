            border-radius: 12px !important;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75), 0 0 24px rgba(212, 175, 55, 0.12) !important;
            padding: 1.25rem 1rem !important;
            margin-top: 0.75rem !important;
        }

        .emdad-navbar .navbar-nav {
            list-style: none !important;
            padding: 0 !important;
            margin: 0 0 1.1rem 0 !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 6px !important;
            width: 100% !important;
        }

        .emdad-navbar .navbar-nav .nav-item {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .emdad-navbar .emdad-nav-link {
            display: flex !important;
            align-items: center !important;
            justify-content: flex-start !important;
            width: 100% !important;
            color: #e2e8f0 !important;
            font-size: 14.5px !important;
            font-weight: 600 !important;
            padding: 10px 16px !important;
            border-radius: 8px !important;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            text-decoration: none !important;
            transition: all 0.25s ease !important;
        }

        .emdad-navbar .emdad-nav-link::after {
            display: none !important;
        }

        .emdad-navbar .emdad-nav-link:hover,
        .emdad-navbar .emdad-nav-link.active {
            background: rgba(212, 175, 55, 0.14) !important;
            color: #f3d078 !important;
            border-color: rgba(212, 175, 55, 0.4) !important;
            border-left: 3px solid #d4af37 !important;
        }

        [dir="rtl"] .emdad-navbar .emdad-nav-link:hover,
        [dir="rtl"] .emdad-navbar .emdad-nav-link.active {
            border-left: 1px solid rgba(212, 175, 55, 0.4) !important;
            border-right: 3px solid #d4af37 !important;
        }

        .nav-extras-wrap {
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 10px !important;
            margin-top: 0.5rem !important;
            padding-top: 1rem !important;
            border-top: 1px solid rgba(212, 175, 55, 0.2) !important;
            width: 100% !important;
        }

        .emdad-lang-pill {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 10px 16px !important;
            border-radius: 8px !important;
            background: rgba(255, 255, 255, 0.06) !important;
            border: 1px solid rgba(212, 175, 55, 0.3) !important;
            color: #ffffff !important;
            font-size: 13.5px !important;
            font-weight: 700 !important;
            width: 100% !important;
            text-decoration: none !important;
        }

        .emdad-btn-quote-header {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 12px 18px !important;
            border-radius: 8px !important;
            background: linear-gradient(135deg, #f5d47a 0%, #d4af37 100%) !important;
            color: #041628 !important;
            font-size: 14px !important;
            font-weight: 800 !important;
            width: 100% !important;
            text-decoration: none !important;
            box-shadow: 0 4px 16px rgba(212, 175, 55, 0.35) !important;
        }

        .emdad-navbar .dropdown-menu {
            position: static !important;
            width: 100% !important;
            margin-top: 5px !important;
            box-shadow: none !important;
            background: rgba(3, 16, 32, 0.95) !important;
            border: 1px solid rgba(212, 175, 55, 0.2) !important;
            transform: none !important;
        }

        .emdad-navbar .dropdown-item {
            color: #e2e8f0 !important;
        }

        .emdad-navbar .dropdown-item:hover,
        .emdad-navbar .dropdown-item.active {
            background: rgba(212, 175, 55, 0.15) !important;
            color: #f3d078 !important;
        }
    }

    @@media (max-width: 575px) {
        .emdad-navbar {
            padding: 0.5rem 0 !important;
        }

        .emdad-brand-main {
            font-size: 22px !important;
            letter-spacing: 2px !important;
        }

        .emdad-brand-sub {
            font-size: 7.5px !important;
            letter-spacing: 2px !important;
        }
    }

</style>

</head>

<body style="width:100%; overflow-x:hidden; min-height:100vh;">


<!-- ========================================================= -->
@{
   

       var isRtlLayout = System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft;
    var currentUrlLayout = Context.Request.Path.Value + Context.Request.QueryString.Value;
    if (string.IsNullOrEmpty(currentUrlLayout)) { currentUrlLayout = "/"; }
    var nextCultureLayout = isRtlLayout ? "en-us" : "ar-eg";

    // المتغيرات لمعرفة اسم الـ Controller والـ Action الحالي
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!-- ========================================================= -->
<!-- NAVBAR (Matches Reference Image) -->
<!-- ========================================================= -->
<nav class="navbar navbar-expand-lg emdad-navbar" id="emdadMainNav">
    <div class="container">

        <!-- LOGO -->
        <a class="navbar-brand text-decoration-none" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <div class="emdad-brand-title">
                <span class="emdad-brand-main">EMDAD</span>
                <span class="emdad-brand-sub">FOR INDUSTRIES</span>
            </div>
        </a>

        <!-- MOBILE TOGGLE -->
        <button class="navbar-toggler emdad-mobile-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#emdadNavCollapse"
                aria-controls="emdadNavCollapse"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>

        <!-- NAVBAR CONTENT -->
        <div class="collapse navbar-collapse" id="emdadNavCollapse">

            <!-- NAVIGATION LINKS -->
            <ul class="navbar-nav mx-auto align-items-center gap-lg-1 gap-1">
                
                <!-- HOME -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Home" asp-action="Index">
                        @(isRtlLayout ? "الرئيسية" : "Home")
                    </a>
                </li>

                <!-- ABOUT US DROPDOWN -->
                <li class="nav-item dropdown">
                    <a class="nav-link emdad-nav-link dropdown-toggle @(currentController == "Home" && (currentAction == "AboutUs" || currentAction == "CompanyStructure") ? "active" : "")" 
                       href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @(isRtlLayout ? "عن إمداد" : "About Us")
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                        <li>
                            <a class="dropdown-item @(currentController == "Home" && currentAction == "AboutUs" ? "active" : "")" 
                               asp-area="Customer" asp-controller="Home" asp-action="AboutUs">
                                @(isRtlLayout ? "عن إمداد" : "About Emdad")
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentController == "Home" && currentAction == "CompanyStructure" ? "active" : "")" 
                               asp-area="Customer" asp-controller="Home" asp-action="CompanyStructure">
                                @(isRtlLayout ? "هيكل الشركة" : "Company Structure")
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- SECTORS -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Home" && currentAction == "Goals" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Home" asp-action="Goals">
                        @(isRtlLayout ? "القطاعات" : "Sectors")
                    </a>
                </li>

                <!-- PRODUCTS -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Category" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Category" asp-action="Categories">
                        @(isRtlLayout ? "المنتجات" : "Products")
                    </a>
                </li>

                <!-- NEWS -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Event" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Event" asp-action="Index">
                        @(isRtlLayout ? "الأخبار" : "News")
                    </a>
                </li>

                <!-- PARTNERS -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Home" && currentAction == "Partners" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Home" asp-action="Partners">
                        @(isRtlLayout ? "الشركاء" : "Partners")
                    </a>
                </li>

                <!-- CONTACT -->
                <li class="nav-item">
                    <a class="nav-link emdad-nav-link @(currentController == "Home" && currentAction == "ContactUs" ? "active" : "")" 
                       asp-area="Customer" asp-controller="Home" asp-action="ContactUs">
                        @(isRtlLayout ? "اتصل بنا" : "Contact")
                    </a>
                </li>
            </ul>

            <!-- RIGHT ACTIONS -->
            <div class="nav-extras-wrap d-flex align-items-center gap-3">
                <a href="/Customer/Language/SetLanguage?culture=@nextCultureLayout&returnUrl=@currentUrlLayout" class="emdad-lang-pill" title="Change Language">
                    <i class="fas fa-globe"></i>
                    <span>EN | AR</span>
                </a>

                <a href="@Url.Action("ContactUs", "Home", new { area = "Customer" })" class="emdad-btn-quote-header">
                    <span>@(isRtlLayout ? "اطلب عرض سعر" : "Request a Quote")</span>
                    <i class="fas fa-arrow-@(isRtlLayout ? "left" : "right")"></i>
                </a>
            </div>

        </div>

    </div>
</nav>


<!-- ========================================================= -->
<!-- PAGE CONTENT -->
<!-- ========================================================= -->

<main style="min-height:100vh;">

    @RenderBody()

</main>


<!-- ========================================================= -->
<!-- SCROLL TOP -->
<!-- ========================================================= -->

<button id="scrollTopBtn"
        class="btn btn-primary"
        style="display:none;">

    <i class="fa fa-arrow-up"></i>

</button>


@RenderSection("Scripts", required: false)


<!-- ========================================================= -->
<!-- FOOTER REDESIGNED PREMIUM -->
<!-- ========================================================= -->

<style>

    /* =====================================================
       FOOTER PREMIUM — EMDAD REDESIGN
       ===================================================== */

    .emdad-premium-footer {
        position: relative;
        background: linear-gradient(160deg, #020c1b 0%, #041628 40%, #071e38 100%);
        color: #ffffff;
        overflow: hidden;
        font-family: @(System.Threading.Thread.CurrentThread.CurrentCulture.TextInfo.IsRightToLeft ? "'Cairo', sans-serif" : "'Inter', -apple-system, sans-serif");
        border-top: 3px solid;
        border-image: linear-gradient(90deg, transparent, #d4a359, #d4af37, #d4a359, transparent) 1;
    }

    /* Background glow orbs */
    .emdad-premium-footer::before {
        content: '';
        position: absolute;
        width: 600px;
        height: 600px;
        top: -300px;
        inset-inline-end: -200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(212,163,89,0.06) 0%, transparent 70%);
        pointer-events: none;
    }

    .emdad-premium-footer::after {
        content: '';
        position: absolute;
        width: 400px;
        height: 400px;
        bottom: -150px;
        inset-inline-start: -100px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(249,115,22,0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    /* =====================================================
       FOOTER MAIN GRID
       ===================================================== */

    .ef-main {
        position: relative;
        z-index: 2;
        padding: 55px 0 45px;
    }

    .ef-grid {
        display: grid;
        grid-template-columns: 1.4fr 0.9fr 1.15fr 1.35fr 0.95fr;
        gap: 28px;
        align-items: start;
    }

    /* =====================================================
       BRAND COLUMN (Matches Footer 2 Brand Logo)
       ===================================================== */

    .ef-brand {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .ef-logo-wrap {
        display: inline-flex;
        text-decoration: none;
    }

    .ef-desc {
        font-size: 0.88rem;
        line-height: 1.8;
        color: rgba(255,255,255,0.68);
        margin: 0;
    }

    /* Social Icons */
    .ef-social {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }

    .ef-social a {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: #cbd5e1;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
        position: relative;
        overflow: hidden;
    }

    .ef-social a::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: var(--s-color, #d4af37);
        opacity: 0;
        transform: scale(0);
        transition: all 0.3s ease;
    }

    .ef-social a:hover::before {
        opacity: 1;
        transform: scale(1);
    }

    .ef-social a i {
        position: relative;
        z-index: 1;
        transition: color 0.3s ease;
    }

    .ef-social a:hover {
        border-color: transparent;
        transform: translateY(-3px) scale(1.08);
        box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        color: #fff;
    }

    .ef-social a[aria-label="Facebook"]  { --s-color: #1877f2; }
    .ef-social a[aria-label="Instagram"] { --s-color: #e1306c; }
    .ef-social a[aria-label="LinkedIn"]  { --s-color: #0a66c2; }

    /* =====================================================
       COLUMN HEADINGS
       ===================================================== */

    .ef-col-title {
        font-size: 0.98rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 20px;
        padding-bottom: 9px;
        position: relative;
        display: inline-block;
        letter-spacing: 0.5px;
    }

    .ef-col-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        inset-inline-start: 0;
        width: 32px;
        height: 2.5px;
        border-radius: 2px;
        background: linear-gradient(90deg, #d4af37, #d4a359);
    }

    /* =====================================================
       LINKS (Quick Links & Industrial Sectors)
       ===================================================== */

    .ef-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .ef-links a {
        color: rgba(255,255,255,0.68);
        text-decoration: none;
        font-size: 0.88rem;
        display: flex;
        align-items: center;
        gap: 9px;
        transition: all 0.25s ease;
        position: relative;
        padding-inline-start: 2px;
    }

    .ef-links a .ef-link-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #d4a359;
        flex-shrink: 0;
        transition: transform 0.25s ease, background 0.25s ease;
    }

    .ef-links a .ef-link-icon {
        color: #d4af37;
        font-size: 13px;
        width: 18px;
        text-align: center;
        flex-shrink: 0;
        transition: transform 0.25s ease, color 0.25s ease;
    }

    .ef-links a:hover {
        color: #ffffff;
        padding-inline-start: 6px;
    }

    .ef-links a:hover .ef-link-dot {
        transform: scale(1.4);
        background: #d4af37;
    }

    .ef-links a:hover .ef-link-icon {
        color: #f3d078;
        transform: scale(1.2);
    }

    /* =====================================================
       CONTACT CARDS
       ===================================================== */

    .ef-contact-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ef-contact-card {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
        cursor: default;
    }

    .ef-contact-card:hover {
        background: rgba(249,115,22,0.07);
        border-color: rgba(249,115,22,0.3);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }

    .ef-contact-icon {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: rgba(249,115,22,0.1);
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .ef-contact-card:hover .ef-contact-icon {
        background: #d4af37;
        color: #ffffff;
        transform: rotate(5deg) scale(1.05);
    }

    .ef-contact-text {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.7);
        line-height: 1.6;
        word-break: break-word;
        min-width: 0;
    }

    .ef-contact-text a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s;
    }

    .ef-contact-card:hover .ef-contact-text a {
        color: #ffffff;
    }

    /* =====================================================
       PATRIOTIC IMAGE AT END
       ===================================================== */

    .ef-image-col {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ef-patriotic-img {
        max-width: 180px;
        width: 100%;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 4px 20px rgba(212,163,89,0.25));
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .ef-patriotic-img:hover {
        transform: scale(1.04);
        filter: drop-shadow(0 6px 25px rgba(249,115,22,0.35));
    }

    /* =====================================================
       DIVIDER & BOTTOM BAR
       ===================================================== */

    .ef-divider {
        position: relative;
        z-index: 2;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(212,163,89,0.3), rgba(249,115,22,0.3), rgba(212,163,89,0.3), transparent);
    }

    .ef-bottom {
        position: relative;
        z-index: 2;
        padding: 16px 0;
        background: rgba(0,0,0,0.25);
    }

    .ef-bottom-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .ef-copyright {
        font-size: 0.82rem;
        color: rgba(255,255,255,0.45);
        margin: 0;
        direction: ltr;
    }

    .ef-copyright strong {
        color: #d4af37;
        font-weight: 700;
    }

    .ef-legal-links {
        display: flex;
        gap: 6px;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 0;
        flex-wrap: wrap;
    }

    .ef-legal-links li + li::before {
        content: '|';
        color: rgba(255,255,255,0.2);
        margin-inline-end: 6px;
        font-size: 0.75rem;
    }

    .ef-legal-links a {
        color: rgba(255,255,255,0.5);
        font-size: 0.8rem;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s ease;
        position: relative;
        padding-bottom: 2px;
    }

    .ef-legal-links a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 1.5px;
        background: #d4af37;
        transition: width 0.3s ease, left 0.3s ease;
        border-radius: 1px;
    }

    .ef-legal-links a:hover {
        color: #ffffff;
    }

    .ef-legal-links a:hover::after {
        width: 100%;
        left: 0;
    }

    /* =====================================================
       LEGAL MODALS
       ===================================================== */

    .ef-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(2,8,20,0.88);
        backdrop-filter: blur(12px);
        z-index: 9000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: efModalFadeIn 0.3s ease;
    }

    .ef-modal-overlay.ef-active {
        display: flex;
    }

    @@keyframes efModalFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .ef-modal-card {
        background: linear-gradient(145deg, #08172e, #0b1c38);
        border: 1.5px solid rgba(212,163,89,0.35);
        border-radius: 18px;
        max-width: 780px;
        width: 100%;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04);
        animation: efModalSlideIn 0.35s cubic-bezier(0.4,0,0.2,1);
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    @@keyframes efModalSlideIn {
        from { opacity: 0; transform: scale(0.94) translateY(20px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    .ef-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        background: rgba(0,0,0,0.25);
        border-bottom: 1px solid rgba(212,163,89,0.2);
        flex-shrink: 0;
    }

    .ef-modal-header h3 {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        font-weight: 800;
        color: #d4a359;
        margin: 0;
    }

    .ef-modal-header h3 .ef-modal-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(212,163,89,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        color: #d4a359;
    }

    .ef-modal-close {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .ef-modal-close:hover {
        background: rgba(249,115,22,0.2);
        border-color: #d4af37;
        color: #d4af37;
    }

    .ef-modal-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
    }

    .ef-modal-body::-webkit-scrollbar { width: 4px; }
    .ef-modal-body::-webkit-scrollbar-track { background: rgba(255,255,255,0.04); }
    .ef-modal-body::-webkit-scrollbar-thumb { background: rgba(212,163,89,0.35); border-radius: 4px; }

    .ef-modal-body p {
        color: rgba(255,255,255,0.72);
        font-size: 0.9rem;
