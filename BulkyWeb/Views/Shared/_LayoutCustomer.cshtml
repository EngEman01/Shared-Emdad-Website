<script>
    // Footer year
    var efYearEl = document.getElementById('efYear');
    if (efYearEl) efYearEl.textContent = new Date().getFullYear();

    function efOpenModal(type) {
        var id = 'ef-modal-' + type;
        var el = document.getElementById(id);
        if (el) { el.classList.add('ef-active'); document.body.style.overflow = 'hidden'; }
    }

    function efCloseModal(id) {
        var el = document.getElementById(id);
        if (el) { el.classList.remove('ef-active'); document.body.style.overflow = ''; }
    }

    function efCheckOverlayClose(e, id) {
        if (e.target === e.currentTarget) efCloseModal(id);
    }

    // ESC key close
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.ef-modal-overlay.ef-active').forEach(function(m) {
                m.classList.remove('ef-active');
            });
            document.body.style.overflow = '';
        }
    });
</script>



