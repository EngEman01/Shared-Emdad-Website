            document.getElementById("emdadAboutDrop");

        var aboutMenu =
            document.getElementById("emdadAboutMenu");

        var aboutContainer =
            document.getElementById("emdadAboutContainer");


        if (!aboutButton ||
            !aboutMenu ||
            !aboutContainer) {

            return;
        }


        aboutButton.addEventListener("click", function (event) {

            event.preventDefault();

            event.stopPropagation();


            var isOpen =
                aboutMenu.classList.contains("show");


            /* Close all other dropdowns */

            document
                .querySelectorAll(".emdad-navbar .dropdown-menu.show")
                .forEach(function (menu) {

                    menu.classList.remove("show");

                });


            document
                .querySelectorAll(".emdad-navbar .dropdown-toggle[aria-expanded='true']")
                .forEach(function (button) {

                    button.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                });


            /* Toggle About */

            if (!isOpen) {

                aboutMenu.classList.add("show");

                aboutButton.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }

        });


        /* Close when clicking outside */

        document.addEventListener("click", function (event) {

            if (!aboutContainer.contains(event.target)) {

                aboutMenu.classList.remove("show");

                aboutButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }

        });


        /* Close when clicking an item */

        aboutMenu
            .querySelectorAll(".dropdown-item")
            .forEach(function (item) {

                item.addEventListener("click", function () {

                    aboutMenu.classList.remove("show");

                    aboutButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                });

            });

    });


    /* =========================================================
       NAVBAR SCROLL
       ========================================================= */

    (function () {

        var nav =
            document.getElementById("emdadMainNav");


        if (!nav) {

            return;
        }


        window.addEventListener(
            "scroll",
            function () {

                if (window.scrollY > 40) {

                    nav.classList.add("scrolled");

                } else {

                    nav.classList.remove("scrolled");

                }

            },
            { passive: true }
        );

    })();


    /* =========================================================
       SCROLL TO TOP
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var mybutton =
                document.getElementById("scrollTopBtn");


            if (!mybutton) {

                return;
            }


            window.addEventListener(
                "scroll",
                function () {

                    if (
                        document.body.scrollTop > 100 ||
                        document.documentElement.scrollTop > 100
                    ) {

                        mybutton.style.display = "block";

                    } else {

                        mybutton.style.display = "none";

                    }

                }
            );


            mybutton.onclick =
                function () {

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });

                };

        }
    );

</script>


</body>

</html>
