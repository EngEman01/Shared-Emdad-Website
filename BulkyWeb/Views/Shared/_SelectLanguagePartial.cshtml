@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options

@inject IViewLocalizer localizer
@inject IOptions<RequestLocalizationOptions> locOptions


@{
	var requestCulture = Context.Features.Get<IRequestCultureFeature>();
	var cultureItems = localizationOptions.Value.SupportedCultures.Select(
		c => new SelectListItem { Value = c.Name, Text = c.NativeName })
		.ToList();
	// Extract current query string to check for a value like categoryId
	var queryString = Context.Request.QueryString.HasValue
		? Context.Request.QueryString.Value
		: string.Empty;

	var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"{Context.Request.Path.Value}{queryString}";
}

<div title="@localizer["Request Culture Provider"] @requestCulture?.Provider?.GetType().Name">
	<form id="selectLanguage" method="post" asp-area="Customer"
		  asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl">
		<select name="culture" class="changeLanguage" onchange="this.form.submit();"
				asp-for="@requestCulture.RequestCulture.UICulture.Name"
				asp-items="cultureItems">
		</select>
	</form>


</div>
